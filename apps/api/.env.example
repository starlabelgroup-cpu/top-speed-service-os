# Local skeleton only. Replace placeholders in your deployment secret manager.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/top_speed_service_os?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-server-side-secret-of-at-least-32-bytes
JWT_EXPIRES_IN_SECONDS=900
BCRYPT_COST=12
CORS_ORIGIN=http://localhost:5173
ALLOW_DEMO_AUTH=true
# Local/bootstrap only: lets POST /auth/register grant staff roles without an
# admin token (e.g. creating the first dispatcher). Production: false — staff
# accounts are then created by a signed-in PLATFORM_ADMIN / COMPANY_OWNER.
ALLOW_STAFF_REGISTRATION=false

# Provider integrations stay server-side. Leave blank until configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notification sending (services/senders.js drains the outbox)
# RESEND_API_KEY (above) sends email; EMAIL_FROM must be an address on a
# domain verified in Resend (DNS records on the domain) or sends will fail.
EMAIL_FROM=Top Speed Appliance <service@updates.topspeedapplianceservice.com>
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_PHONE_NUMBER (above) send
# SMS from the Twilio number. US A2P 10DLC registration applies to the number.
# CRON_SECRET enables GET /api/v1/notifications/cron-drain for Vercel Cron;
# leave unset to keep that endpoint closed.
CRON_SECRET=

# Speedy AI assistant (OpenAI)
# OPENAI_API_KEY powers POST /api/v1/speedy/chat and /speedy/diagnose.
# OPENAI_MODEL defaults to gpt-4o-mini (vision-capable); set gpt-4o for the
# strongest photo diagnosis.
OPENAI_API_KEY=
OPENAI_MODEL=
