// Speedy chat capture (2026-11-12): every customer conversation with
// Speedy lands here for staff analysis (Chat Insights) — Ramone's
// direction: every customer chat is valuable information for developing
// new features and methods of operations. Capture is passive and
// best-effort: a capture failure never breaks or blocks the chat.
// Transcripts are staff-only data — no public endpoint ever returns
// them. Photo diagnoses record that a diagnosis happened plus the
// customer's note text; the image itself is never stored.
model SpeedyChatSession {
  id                        String   @id @default(uuid()) @db.Uuid
  companyId                 String   @db.Uuid
  userId                    String?  @db.Uuid
  source                    String   @default("unknown")
  startedAt                 DateTime @default(now())
  lastMessageAt             DateTime @default(now())
  messageCount              Int      @default(0)
  hadDiagnosis              Boolean  @default(false)
  convertedBookingReference String?
  hasUnanswered             Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  messages SpeedyChatMessage[]

  @@index([companyId, startedAt])
  @@index([companyId, source, startedAt])
}

model SpeedyChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  role      String
  content   String
  // flagged = this row is evidence for the unanswered mining: an
  // assistant reply that hit the knowledge boundary, or a customer
  // message whose exchange errored out (the client-side snag path).
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now())

  session SpeedyChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Multi-account Google manager registry (2026-11-13): Ramone runs the
// Google presence — Business Profile, Local Services Ads, Google Ads,
// Search Console — from more than one Gmail account, and directed a
// registry inside Marketing OS where more Gmail accounts can be added,
// each with its business profiles and ads accounts, all linked to the
// Service OS. This table is that registry. It is a RECORD of the
// structure, not a live Google connection: invites are sent and
// accepted inside Google's own screens, and a human updates a status
// here after the Google side confirms it. Statuses stay truthful —
// nothing auto-flips an INVITED account to ACTIVE.
model GoogleAccountLink {
  id     String @id @default(uuid()) @db.Uuid
  email  String @unique
  label  String
  // PRIMARY_OWNER / OWNER / MANAGER / ADMIN
  role   String @default("MANAGER")
  // INVITED / ACTIVE / REVOKED
  status String @default("INVITED")
  // Structured asset links, kept as JSON so the registry can grow new
  // asset kinds without a migration each time:
  // { gbpProfiles: [{ name, verificationStatus }],
  //   adsAccounts: [{ customerId, name, status }],
  //   lsaAccounts: [{ id, status }],
  //   searchConsole: boolean }
  assets Json   @default("{}")

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Top Speed Media OS — Phase 1 (2026-11-14, blueprint
// Top_Speed_Media_OS_Expanded_Blueprint, built on the existing Service
// OS stack per the approved digest). The content library behind
// /media: five divisions (Videos, Publishing, News, Social, Live), one
// editorial workflow (DRAFT → IN_REVIEW → APPROVED → SCHEDULED →
// PUBLISHED → ARCHIVED, enforced in routes/mediaOs.js), and an asset
// registry carrying rights status. Hydrated from these tables via
// db/mediaOsRepo into the in-memory store, like the Marketing OS
// add-ons; a missing table mid-deploy degrades to an empty library.
model MediaContent {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique
  type           MediaContentType
  division       MediaDivision
  title          String
  description    String?
  assetUrl       String?
  thumbnailUrl   String?
  durationSec    Int?
  transcript     String?            @db.Text
  destinationUrl String?
  status         MediaContentStatus @default(DRAFT)
  publishAt      DateTime?
  publishedAt    DateTime?
  tags           String[]           @default([])
  createdBy      String
  updatedBy      String
  // Content Creator / Publisher accounts (2026-11-19): the owning
  // creator account for items submitted through the Media OS creator
  // workspace. Null = staff-owned (every pre-existing record and
  // everything the admin console creates); a creator only ever sees
  // and touches rows carrying their own id here.
  ownerId        String?            @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  owner User? @relation("MediaContentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  assets MediaAsset[]

  @@index([ownerId])

  adCampaigns AdCampaign[]

  @@index([status, division])
  @@index([division, publishedAt])
}

model MediaAsset {
  id          String                 @id @default(uuid()) @db.Uuid
  contentId   String?                @db.Uuid
  kind        String
  name        String
  url         String?
  rightsStatus MediaAssetRightsStatus @default(PENDING_REVIEW)
  rightsNote  String?
  createdAt   DateTime               @default(now())

  content MediaContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([contentId])
}

// Media OS → Facebook Page publish queue (2026-11-20, Wave 3 E6).
// When staff PUBLISH a Media OS record, a ready-to-post package for
// the Top Speed Facebook Page (Repair & Installation,
// 1437372132795817) is queued here. There is NO server-side Facebook
// write anywhere in the platform: Pepper executes queued rows
// through the owner's connected Facebook account behind Ramone's
// approval (the facebookConnector attestation), and staff record the
// real outcome — POSTED only with the real facebook.com post URL,
// FAILED only with the real reason. Until an outcome exists the
// honest status is QUEUED ("Queued for posting") — never "posted".
// contentId is a plain column (the PepperListsCrossPost precedent)
// so the dual-mode repo keeps identical shapes with/without a DB.
enum MediaFacebookPostStatus {
  QUEUED
  POSTED
  FAILED
}

model MediaFacebookPost {
  id          String                  @id @default(uuid()) @db.Uuid
  contentId   String                  @db.Uuid
  contentSlug String
  pageId      String
  pageName    String
  message     String                  @db.Text
  linkUrl     String?
  imageUrl    String?
  status      MediaFacebookPostStatus @default(QUEUED)
  externalId  String?
  externalUrl String?
  error       String?
  outcomeById String?                 @db.Uuid
  postedAt    DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([contentId, status])
  @@index([status, createdAt])
}

// Public Help Center publishing state (2026-11-20, Wave 3 E5).
// The help articles themselves are Speedy's grounded knowledge
// entries (apps/api/src/knowledge — rebuilt from live platform
// sources on every read, so they can never drift). This table holds
// ONLY the human publishing decision per entry: no row (or a DRAFT
// row) means the article is NOT public; a PUBLISHED row — set by a
// staff member, never automatically — is what lets /help serve it.
// entryId is the knowledge entry's stable id (a plain string: the
// knowledge packs are code, not database rows).
model HelpArticleState {
  id          String    @id @default(uuid()) @db.Uuid
  entryId     String    @unique
  status      String    @default("DRAFT") // DRAFT | PUBLISHED
  updatedById String?   @db.Uuid
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// ─── Ad Studio (in-house advertising system, 2026-11-14) ────────────
// Ramone's own ad system on the Service OS: campaigns are built from
// Media OS creatives, send traffic to his own published landing pages,
// and run as placements on his own platform surfaces (the flagship
// footer Banner rotation). Nothing outside is bought and no money
// moves — a campaign goes live only when the owner (MASTER) approves
// it, and results are counted from real bookings/connections that
// carry the campaign's sourceTag.
enum AdBusinessLine {
  TOP_SPEED
  CLEANOUT_VENTS
  COCOCANE
  // Flywheel Advertising (2026-11-16): campaigns owned by an external
  // advertiser account (Advertiser Console self-serve). The business
  // identity rides on the campaign's advertiserName field, not the line.
  EXTERNAL
}

enum AdCampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  ENDED
}

enum AdPlacement {
  BANNER
  NONE
  // Streaming Ads channel (Flywheel AI Advertising, 2026-11-17):
  // Google-style text/display creative aimed at streaming TV
  // providers. STREAMING campaigns never enter the owned-surface
  // banner feed — that feed stays BANNER-only.
  STREAMING
}

enum AdStreamingFormat {
  TEXT
  DISPLAY
}

model AdCampaign {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  businessLine   AdBusinessLine
  objective      String
  status         AdCampaignStatus @default(DRAFT)
  creativeId     String?          @db.Uuid
  destinationUrl String
  sourceTag      String           @unique
  placement      AdPlacement      @default(NONE)
  bannerId       String?          @db.Uuid
  // Flywheel advertiser fields (2026-11-16, all nullable — house
  // campaigns leave them null and resolve from businessLine + creative):
  // the advertiser's business name as shown on the ad, the product or
  // service advertised, the ad's own headline/copy/CTA (when no Media
  // OS creative carries them), and the relatedness category the
  // mini-banner display uses to prefer related surfaces.
  advertiserName String?
  offering       String?
  headline       String?
  copy           String?
  ctaText        String?
  category       String?
  // Streaming Ads fields (2026-11-17, all nullable / empty for
  // non-streaming campaigns): the Google-style creative a STREAMING
  // campaign carries. streamingProviders are LABELS only (Roku,
  // YouTube TV, Hulu, …) — no streaming provider ad account is
  // connected to this system; placing ads there is a separate,
  // later activation. headlines/descriptions follow Google Ads
  // limits (30 / 90 chars), enforced in routes/adStudio.js.
  streamingFormat    AdStreamingFormat?
  // Top Speed Ads creative picker (2026-11-17): a house creative
  // image chosen from the scenario/poster asset library, stored as
  // its served URL. Wins over the Media OS creative's image in the
  // display resolution; null keeps the pre-existing behavior.
  imageUrl           String?
  streamingProviders String[]           @default([])
  headlines          String[]           @default([])
  descriptions       String[]           @default([])
  displayPath        String?
  longHeadline       String?
  displaySizes       String[]           @default([])
  notes              String?
  createdById    String?          @db.Uuid
  approvedById   String?          @db.Uuid
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  creative MediaContent? @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([businessLine, status])
}

// Flywheel Advertiser Plans (2026-11-17): the paid-plan layer of the
// Flywheel AI Advertising ecosystem. AdPlan rows are STRUCTURE — tiers
// with a feature matrix and limits. monthlyPriceCents stays NULL until
// the OWNER sets a price in Ad Studio; an unpriced plan can never be
// checked out, and a Stripe Product/Price exists only because the
// owner set a price (the sync happens in routes/adPlans.js at that
// moment — never from seed data, never invented).
//
// AdvertiserSubscription is one row per advertiser account. The stored
// status is the billing state machine's durable state; the EFFECTIVE
// status is computed at read time in services/adPlans.js (a stored
// PAST_DUE reads GRACE inside the owner-configured grace window and
// SUSPENDED beyond it — GRACE exists in the enum for that computed
// value and for any future stored use). Existing advertiser accounts
// are GRANDFATHERED (baseline = today's access, forever theirs); the
// owner can also OFFICE_GRANTED any plan without payment (grantedById
// + grantedAt are the audit trail, alongside the management report
// every grant files). The owner and staff are never plan-gated.
enum AdSubscriptionStatus {
  NONE
  GRANDFATHERED
  ACTIVE
  TRIALING
  PAST_DUE
  GRACE
  SUSPENDED
  OFFICE_GRANTED
}

model AdPlan {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique
  name              String
  description       String?
  // NULL = pricing not set by the owner yet — checkout is refused
  // with an honest "pricing not set" state everywhere it appears.
  monthlyPriceCents Int?
  currency          String   @default("usd")
  // Feature matrix: { <featureKey>: true|false } over the keys in
  // services/adPlans.js PLAN_FEATURES. Limits: { maxCampaigns:
  // number|null (null = unlimited), channels: string[] }.
  features          Json     @default("{}")
  limits            Json     @default("{}")
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  // Set only by the owner price flow (Stripe sync at price-set time).
  stripeProductId   String?
  stripePriceId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions AdvertiserSubscription[]

  @@index([isActive, sortOrder])
}

model AdvertiserSubscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @db.Uuid
  planId               String?            @db.Uuid
  status               AdSubscriptionStatus @default(NONE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  // When the first failed invoice landed; the grace clock starts here.
  pastDueAt            DateTime?
  // Scheduled downgrade: applied lazily at currentPeriodEnd.
  pendingPlanId        String?            @db.Uuid
  pendingEffectiveAt   DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  // Office grant audit (status OFFICE_GRANTED): who granted it, when.
  // Revocation clears the plan and falls back to the account's own
  // baseline (GRANDFATHERED or NONE by eligibility).
  grantedById          String?            @db.Uuid
  grantedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan AdPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([stripeSubscriptionId])
}

// Owner-configurable billing settings (singleton row, id 'default'):
// the past-due grace window in days (default 7, per the plan spec).
model AdBillingSetting {
  id        String   @id
  graceDays Int      @default(7)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Management department reports (2026-11-14): every request any platform
// feature produces — booking, referral, subscription/offer sign-up,
// account, job event, payment, training, publish, campaign action —
// lands here as ONE report routed to the head department that owns it,
// with the exact request detail, for management to read + acknowledge.
// Emitted failure-proof from services/managementReports.js; the
// in-memory store is the working set, this table is the durable record.
model DepartmentReport {
  id         String   @id @default(uuid()) @db.Uuid
  department String
  type       String
  title      String
  detail     Json     @default("{}")
  source     String?
  reference  String?
  eventKey   String?  @unique
  status     String   @default("NEW")
  ackById    String?  @db.Uuid
  ackAt      DateTime?
  createdAt  DateTime @default(now())

  @@index([department, status])
  @@index([createdAt])
}

// Pepper Lists Channel Connections (2026-11-17, Phase 1): one row per
// external channel a Pepper Lists seller account has connected or
// requested. SELL channels syndicate listings (Facebook Marketplace,
// Google Shopping, eBay, Etsy, Walmart); POST channels publish posts
// (TikTok, Facebook, YouTube, Instagram, X, LinkedIn) and carry the
// seller's search-directory presence (Google Business Profile, Bing
// Places, and a general search-directories request — added
// 2026-11-17 with the three-purpose consolidation). Phase 1 is the
// registry + request workflow ONLY: a connect files a PENDING request
// the office completes on the platform side, exactly like the
// Advertiser Console's ChannelLink system. A row may read CONNECTED
// only after a real completed connect flow — never by default, and
// Phase 1 stores NO third-party tokens anywhere (meta carries only
// non-secret request context). agentAccessGranted is the seller's
// explicit, revocable per-channel grant for the Muse agent (Pepper)
// to manage that channel for them; every change lands in
// SellerChannelAudit.
enum SellerChannel {
  FACEBOOK
  GOOGLE_SHOPPING
  EBAY
  ETSY
  WALMART
  TIKTOK
  YOUTUBE
  INSTAGRAM
  X
  LINKEDIN
  GOOGLE_BUSINESS
  BING_PLACES
  SEARCH_DIRECTORIES
}

enum SellerChannelKind {
  SELL
  POST
}

enum SellerChannelStatus {
  NOT_CONNECTED
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

model SellerChannelConnection {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @db.Uuid
  channel              SellerChannel
  kind                 SellerChannelKind
  status               SellerChannelStatus @default(NOT_CONNECTED)
  externalAccountLabel String?
  agentAccessGranted   Boolean             @default(false)
  connectedAt          DateTime?
  lastSyncAt           DateTime?
  meta                 Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  audit SellerChannelAudit[]

  @@unique([userId, channel])
  @@index([status])
}

model SellerChannelAudit {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @db.Uuid
  userId       String   @db.Uuid
  action       String
  detail       String?
  createdAt    DateTime @default(now())

  connection SellerChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([userId, createdAt])
}

// Pepper Lists — Facebook cross-post queue (2026-11-20, Phase A of
// "Pepper Lists fully compatible with the Facebook platform"). A
// seller asks for one of their confirmed listings (a PEPPER_LISTS_SELL
// Connection record) to be posted to Facebook; the request lands here
// as QUEUED and Pepper executes it through the owner's connected
// Facebook account behind Ramone's per-listing approval — the same
// manual Marketplace flow as always, now with a durable queue and a
// truthful seller-facing status. There is NO official API for
// personal-profile Marketplace posting and NO automated Facebook
// write anywhere in the server: a row reaches POSTED only when staff
// record the real outcome (with the real Facebook listing URL), or
// FAILED with the real reason. connectionId / userId / outcomeById
// are plain columns (the SubmissionMedia precedent) so the dual-mode
// repo keeps identical shapes with and without a database.
enum PepperListsCrossPostTarget {
  MARKETPLACE
  PAGE
}

enum PepperListsCrossPostStatus {
  QUEUED
  POSTED
  FAILED
}

model PepperListsCrossPost {
  id               String                     @id @default(uuid()) @db.Uuid
  connectionId     String                     @db.Uuid
  listingReference String
  userId           String                     @db.Uuid
  target           PepperListsCrossPostTarget
  pageId           String?
  status           PepperListsCrossPostStatus @default(QUEUED)
  externalId       String?
  externalUrl      String?
  error            String?
  outcomeById      String?                    @db.Uuid
  postedAt         DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([connectionId, target, status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// AdStream Providers (2026-11-18, Phase 1): the platform-level registry
// of the external ad-serving providers Top Speed Ads can serve through
// (Kevel, AdButler, Google Ad Manager, SpringServe by Magnite,
// FreeWheel). Unlike the Pepper Lists seller channels, these connections
// belong to the PLATFORM — one row per provider, managed from Ad Studio
// by staff — because the providers serve Top Speed's own ad stack, not
// individual advertiser accounts. Phase 1 is the registry + request
// workflow ONLY, the same honesty model as SellerChannelConnection: a
// connect files a PENDING request the office completes once the real
// provider account exists; a row may read CONNECTED only after a real
// completed connect flow (Phase 2, per provider), and Phase 1 stores NO
// third-party credentials anywhere (meta carries only non-secret
// request context). Every change lands in AdProviderAudit with the
// acting staff member recorded.
enum AdServingProvider {
  KEVEL
  ADBUTLER
  GOOGLE_AD_MANAGER
  SPRINGSERVE
  FREEWHEEL
}

enum AdProviderConnectionStatus {
  NOT_CONNECTED
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

model AdProviderConnection {
  id                   String                     @id @default(uuid()) @db.Uuid
  provider             AdServingProvider          @unique
  status               AdProviderConnectionStatus @default(NOT_CONNECTED)
  externalAccountLabel String?
  connectedAt          DateTime?
  lastSyncAt           DateTime?
  meta                 Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  audit AdProviderAudit[]

  @@index([status])
}

model AdProviderAudit {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String
  detail       String?
  createdAt    DateTime @default(now())

  connection AdProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  actor      User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([connectionId, createdAt])
  @@index([actorUserId, createdAt])
}

// Pepper — Systems Manager console (2026-11-18): the report log of
// Pepper's duty post inside the Workstation. Staff file reports here
// (status updates, actions taken, items that need the owner, incidents)
// and the console at /pepper renders them newest first for Ramone.
// Reports are statements by the staff member who filed them — the
// createdBy link is SetNull so a report outlives the account that
// filed it, exactly like AdProviderAudit's actor.
enum PepperReportCategory {
  STATUS
  ACTION_TAKEN
  NEEDS_OWNER
  INCIDENT
}

model PepperReport {
  id              String               @id @default(uuid()) @db.Uuid
  title           String
  body            String
  category        PepperReportCategory
  createdByUserId String?              @db.Uuid
  createdAt       DateTime             @default(now())

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([createdByUserId, createdAt])
}

// Tech App dispatch package (2026-11-19, Ramone's full-package rebuild
// shaped by the "Top Speed Service OS Enterprise" blueprint): the two
// record types the platform did not have. Plain id columns in the
// CrmNote / InboxMessage style — the working set is the in-memory store
// with write-through persistence, and a field record must never fail to
// save because a referenced row lives only in memory.
//
// Property: a customer's service location as its own record — the
// address a job is worked at plus the access notes a technician needs
// (gate, parking, pets). Bookings keep their own serviceAddress
// snapshot; a Property row is the durable, editable version of that
// address, created from the field or the office. (Blueprint: the
// enterprise package's Property — name/customerId/address/unit/
// accessNotes; label is its name, city/zip are the live platform's
// required address fields.)
model Property {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  customerId  String   @db.Uuid
  label       String?
  address     String
  city        String
  zip         String
  unit        String?
  accessNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
}

// Warranty: the coverage record for ONE job's appliance (blueprint:
// the enterprise package's Warranty, looked up BY APPLIANCE in its
// /work-orders/:id/full join). The live platform has no standalone
// appliance table for jobs — a job's appliance identity is the
// booking's type plus the rating-plate facts the technician records
// (diagnosis brand/model/serial) — so the row carries that identity
// snapshot and the lookup matches on it (same customer + serial when
// a serial is known, else the job itself). Coverage RECORDED here is
// a fact a human entered; the platform's standard repair warranty
// terms live in Speedy's knowledge base and are never restated by
// this record.
model Warranty {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  serviceRequestId String    @db.Uuid
  customerId       String?   @db.Uuid
  applianceType    String?
  brand            String?
  model            String?
  serial           String?
  provider         String
  coverage         String?
  policyNumber     String?
  expiresAt        DateTime?
  claimStatus      String    @default("Not Filed")
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId])
  @@index([serviceRequestId])
  @@index([serial])
}

// WarrantyClaim: a first-class warranty claim filed against a job
// (blueprint: the package's WarrantyClaim — warrantyId + jobId,
// authorization, status, notes). A claim is the durable, searchable
// record the warranty lookup reads — status moves OPEN → FILED →
// APPROVED / DENIED → CLOSED, one recorded step at a time, never on
// its own. Amounts are claim amounts recorded by a human — filing a
// claim never approves, pays, or certifies anything (2026-11-10
// authority limits: refunds and compliance stay human decisions).
model WarrantyClaim {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  serviceRequestId String   @db.Uuid
  assignmentId     String?  @db.Uuid
  customerId       String?  @db.Uuid
  warrantyId       String?  @db.Uuid
  claimNumber      String?
  warrantyProvider String?
  authorization    String?
  status           String   @default("OPEN")
  description      String
  notes            String?
  amountCents      Int?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId, status])
  @@index([serviceRequestId])
  @@index([warrantyId])
}
// Platform Interconnect (2026-11-19): the DURABLE cross-platform event
// feed. appendEvent() in data/store.js has always collected the
// platform's operational events (bookings, completions, referrals,
// reviews, advertiser and provider job events) into an in-memory list —
// on serverless that list dies with the instance, so the "one timeline
// for every surface" was never actually durable. This table is the
// write-through record of the same feed: one row per appendEvent call,
// written at the flow's existing success point, read by staff through
// GET /platform/events and the Platform Interconnect console.
// No relations on purpose: entityId/referenceCode are plain reference
// strings (the feed spans every entity kind), and details is a small
// operational summary — never customer PII beyond what staff consoles
// already show staff (the repo scrubs contact-shaped keys and caps
// the payload size before a row is written).
model PlatformEvent {
  id            String   @id @default(uuid()) @db.Uuid
  type          String
  source        String?
  actor         String?
  entityType    String?
  entityId      String?
  referenceCode String?
  details       Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([source, createdAt])
}

// Satellite Website Tracking Number System (2026-11-19): the registry
// of the phone numbers and email addresses each surface publishes, so
// every contact — booking, call, text, email — can be attributed back
// to the surface it came from. A row with status PLANNED has value null:
// the surface has no dedicated number yet (honest state, never an
// invented number). The shared platform line (+18444607038) is one
// ACTIVE row with shared = true on the 'platform' surface. Rows are
// never deleted — RETIRED is the end state. seedKey identifies the
// rows the idempotent seed owns; manager-created rows carry null.
model TrackingNumber {
  id         String   @id @default(uuid()) @db.Uuid
  kind       String // PHONE | EMAIL
  value      String? // E.164 phone or email address; null while PLANNED
  label      String
  surfaceKey String // canonical interconnect surface key, or 'platform'
  channels   String[] // subset of VOICE / SMS / EMAIL
  status     String   @default("PLANNED") // ACTIVE | PLANNED | RETIRED
  shared     Boolean  @default(false)
  notes      String?
  seedKey    String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contactEvents ContactEvent[]

  @@index([surfaceKey])
  @@index([status])
  @@index([kind, value])
}

// One row per inbound call or text that reached a tracked number,
// written by the Twilio webhooks AFTER their response is computed
// (fail-open: a logging error never changes the TwiML a caller or
// texter receives). surfaceKey is resolved from the DIALED number
// (To): a registered ACTIVE number carries its surface; anything else
// lands on 'platform' with trackingNumberId null (unattributed —
// counted as such in ApplianceMan, never guessed). externalSid is the
// Twilio CallSid / MessageSid; the unique constraint is the dedupe
// (Twilio retries and repeat deliveries collapse to one row).
model ContactEvent {
  id               String          @id @default(uuid()) @db.Uuid
  channel          String // VOICE | SMS
  trackingNumberId String?         @db.Uuid
  surfaceKey       String
  fromNumber       String
  toNumber         String
  externalSid      String?         @unique
  createdAt        DateTime        @default(now())
  trackingNumber   TrackingNumber? @relation(fields: [trackingNumberId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([trackingNumberId, createdAt])
  @@index([surfaceKey, createdAt])
}

// Web Push subscriptions for the customer app (2026-11-20, approved
// recommendation B1): one row per device/browser a signed-in customer
// opted in on. The endpoint is the push service's per-device URL
// (unique); p256dh + auth are the subscription's encryption keys as
// issued by the browser. revokedAt is set when the customer turns
// updates off on that device, when they unsubscribe, or when the push
// service reports the subscription gone (404/410 at delivery) — a
// revoked row is never sent to again. Subscriptions are per-device:
// one account can hold several active rows.
model PushSubscription {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
