// Top Speed Service OS — canonical Phase 1 Prisma schema.
// Company is the tenant boundary (companyId). IDs are UUIDs and money uses Decimal(10, 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  PLATFORM_ADMIN
  COMPANY_OWNER
  COMPANY_ADMIN
  DISPATCHER
  CUSTOMER
  PROVIDER_OWNER
  PROVIDER_TECH
  TECHNICIAN
  ADVERTISER
  MARKETING_MANAGER
  DEVELOPER
}

enum CompanyType {
  PLATFORM_OWNER
  NETWORK_BUSINESS
  INDEPENDENT_PROVIDER
  CUSTOMER_COMPANY
}

enum BookingStatus {
  PENDING_DISPATCH
  MATCH_PENDING_APPROVAL
  CONFIRMED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeeStatus {
  COLLECTED_AT_BOOKING
  NOT_COLLECTED
  REFUNDED
}

enum DispatchMode {
  HYBRID
  MANUAL
  AUTOMATIC
}

enum AssignmentStatus {
  PROPOSED
  APPROVED
  ACCEPTED
  NOT_SELECTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ProviderType {
  NETWORK_BUSINESS
  INDEPENDENT_PROVIDER
  INTERNAL_TEAM
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  VOID
}

model Company {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  slug      String      @unique
  type      CompanyType
  isPlatformOwner Boolean @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  users               User[]
  customers           Customer[]
  serviceRequests     ServiceRequest[]
  dispatchAssignments DispatchAssignment[]
  providers           Provider[]
  invoices            Invoice[]
  referrals           Referral[]
  notificationOutbox  NotificationOutbox[]
  videoRequests       VideoConsultRequest[]
  payments            Payment[]
  channelLinks ChannelLink[]

  @@index([type])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  email        String
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  roles        Role[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  channelLinks ChannelLink[]

  @@unique([companyId, email])
  @@index([companyId])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  userId    String?  @db.Uuid
  source    String?
  name      String
  phone     String
  email     String?
  address   String?
  city      String
  zip       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  invoices        Invoice[]

  @@index([companyId])
  @@index([companyId, phone])
}

// The booking record exposed by the API as /bookings.
model ServiceRequest {
  id                              String        @id @default(uuid()) @db.Uuid
  companyId                       String        @db.Uuid
  customerId                      String        @db.Uuid
  city                            String
  zip                             String
  appliance                       String
  issue                           String
  preferredWindow                 String?
  referenceCode                   String?       @unique
  source                          String        @default("WEBSITE")
  // Working-state documents the API services operate on. The relational
  // core (customer, status, fee, assignments) stays in columns/tables;
  // these JSON columns carry the booking's event history, its dispatch
  // state, and its Book OS appointment exactly as the services produce them.
  history                         Json          @default("[]")
  dispatch                        Json?
  appointment                     Json?
  completedAt                     DateTime?
  completedBy                     String?
  status                          BookingStatus @default(PENDING_DISPATCH)
  diagnosticFee                   Decimal       @default(99.00) @db.Decimal(10, 2)
  diagnosticFeeCreditedTowardRepair Boolean     @default(true)
  feeStatus                       FeeStatus     @default(COLLECTED_AT_BOOKING)
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  dispatchAssignments DispatchAssignment[]
  invoices            Invoice[]
  payments            Payment[]
  trackingTokens      TrackingToken[]

  @@index([companyId, status])
  @@index([companyId, zip])
}

model Provider {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @db.Uuid
  businessName  String
  type          ProviderType
  specialties   String[]
  serviceCities String[]
  rating        Decimal?     @db.Decimal(3, 2)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dispatchAssignments DispatchAssignment[]

  @@index([companyId])
  @@index([active])
}

model DispatchAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  serviceRequestId String           @db.Uuid
  providerId      String           @db.Uuid
  status          AssignmentStatus @default(PROPOSED)
  dispatchMode    DispatchMode     @default(HYBRID)
  approvalRequired Boolean         @default(true)
  matchScore      Int?
  providerCompanyId String?        @db.Uuid
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  // Track My Tech live GPS: the technician device's latest reported
  // position for this assignment (only ever set by a real device report).
  lastLat         Float?
  lastLng         Float?
  lastLocationAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([serviceRequestId])
  @@index([providerId])
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @db.Uuid
  serviceRequestId String        @db.Uuid
  customerId       String        @db.Uuid
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @default(0.00) @db.Decimal(10, 2)
  diagnosticFee    Decimal       @default(99.00) @db.Decimal(10, 2)
  diagnosticCredit Decimal       @default(99.00) @db.Decimal(10, 2)
  total            Decimal       @default(0.00) @db.Decimal(10, 2)
  currency         String        @default("USD")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([serviceRequestId])
}

// Flywheel persistence (2026-11-09): referral codes and the notification
// outbox move from the in-memory store to the database so they survive
// cold starts. Redemptions and payloads ride in JSON columns in exactly
// the shapes the services produce; the relational core stays in columns.
model Referral {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @db.Uuid
  code                    String
  customerId              String?  @db.Uuid
  customerName            String?
  customerPhone           String?
  status                  String   @default("ACTIVE")
  issuedFromBookingId     String?  @db.Uuid
  issuedFromReferenceCode String?
  redemptions             Json     @default("[]")
  issuedAt                DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
}

model NotificationOutbox {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  channel    String
  template   String
  to         String
  payload    Json      @default("{}")
  status     String    @default("QUEUED_SIMULATED")
  eventKey   String?   @unique
  eventType  String?
  reason     String?
  attempts   Int       @default(0)
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([createdAt])
}

// Unified notifications system (2026-11-11): staff toggles for the
// alerts pipeline — staff email alerts, staff SMS alerts, customer
// email/SMS confirmations. Key/value rows; a missing row means the
// ALL-ON default in services/notifications.js.
model NotificationSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  enabled   Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Speedy Live Video (2026-11-09): a customer asks to show the problem
// live; Service Setters arrange it — immediate, scheduled, or
// manager-assisted — and the request gets a video room both sides join.
model VideoConsultRequest {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  customerName     String
  phone            String
  appliance        String
  note             String?
  bookingReference String?
  mode             String   @default("UNDECIDED")
  status           String   @default("PENDING")
  roomName         String?  @unique
  arrangedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

/**
 * A customer payment collected through Stripe — the payment ledger.
 * One row per Checkout session attempt. The webhook flips PENDING →
 * PAID; `diagnosticPaid` everywhere in the API is derived from a PAID
 * row for the booking, so this table is the single source of truth
 * for money received online (the feeStatus column on ServiceRequest
 * remains the office's manual bookkeeping).
 */
model Payment {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @db.Uuid
  serviceRequestId      String    @db.Uuid
  customerId            String?   @db.Uuid
  purpose               String    @default("DIAGNOSTIC")
  amountCents           Int
  currency              String    @default("usd")
  status                String    @default("PENDING")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  checkoutUrl           String?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([serviceRequestId])
}

// One row per ad-channel connection an advertiser-console user has
// requested or completed (Google Ads, Meta, TikTok, ...). The link itself
// is completed by the team (manager-account link / partner access), so a
// row starts PENDING_LINK and staff flip it to CONNECTED. This table is
// the connect system's record; live metrics sync arrives with each
// platform's API approval.
model ChannelLink {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  userId     String   @db.Uuid
  channel    String
  accountRef String
  status     String   @default("PENDING_LINK")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([companyId, status])
}

model Connection {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  email     String?
  type      String
  source    String?
  message   String?
  reference String   @unique
  createdAt DateTime @default(now())
}

model CustomerAppliance {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  brand     String?
  model     String?
  serial    String?
  year      Int?
  notes     String?
  createdAt DateTime @default(now())
}

model Banner {
  id             String   @id @default(uuid()) @db.Uuid
  placement      String   @default("FOOTER")
  advertiserName String
  headline       String
  copy           String?
  imageUrl       String?
  ctaText        String?
  ctaUrl         String
  active         Boolean  @default(true)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Secure per-job customer tracking links (Track My Tech, 2026-11-11):
// only the SHA-256 hash of the token is stored; the raw token exists
// solely in the link given to the verified customer. Links expire and
// issuing a new link revokes the previous ones for that booking.
model TrackingToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  bookingId String    @db.Uuid
  issuedBy  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  booking ServiceRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ─── Top Speed Marketing OS (Phase 1 Foundation, 2026-11-11) ───
// The agency's data layer on the Service OS backend: the §3 taxonomy
// (cities / brands / services / symptoms), the Page Studio landing
// pages (§4 URL scheme), and a full version snapshot per content save
// (§12 draft/preview/publish workflow + revisions). Expansion cities
// are records only — the publish path refuses non-covered cities.

enum LandingPageType {
  CITY
  BRAND
  SERVICE
  BRAND_SERVICE
  BRAND_SERVICE_CITY
}

enum LandingPageStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  UNPUBLISHED
}

model MarketingCity {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  slug           String   @unique
  state          String   @default("FL")
  serviceCovered Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pages LandingPage[]
}

model MarketingBrand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages LandingPage[]
}

model MarketingService {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  slug          String   @unique
  // Slug of the canonical service this entry is scoped inside
  // (Cooktop -> oven-range-repair); null for standalone services.
  partOfService String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pages LandingPage[]
}

model MarketingSymptom {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPage {
  id              String            @id @default(uuid()) @db.Uuid
  type            LandingPageType
  cityId          String?           @db.Uuid
  brandId         String?           @db.Uuid
  serviceId       String?           @db.Uuid
  slug            String
  canonicalUrl    String            @unique
  title           String
  metaDescription String?
  status          LandingPageStatus @default(DRAFT)
  sections        Json              @default("[]")
  createdBy       String?
  updatedBy       String?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  city     MarketingCity?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  brand    MarketingBrand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  service  MarketingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  versions PageVersion[]

  @@index([status, type])
  @@index([cityId])
  @@index([brandId])
  @@index([serviceId])
}

model PageVersion {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  version   Int
  snapshot  Json
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  page LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId])
}

// Parts Supply OS (2026-11-11): suppliers, parts inventory, purchase
// orders and per-job parts usage. Operations data — staff only at the
// API. Usage snapshots the part's unit cost at the moment of use so job
// costing survives later price changes.
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  contact   String?
  phone     String?
  email     String?
  terms     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts          Part[]
  purchaseOrders PurchaseOrder[]
}

model Part {
  id             String   @id @default(uuid()) @db.Uuid
  sku            String   @unique
  name           String
  category       String
  brand          String?
  unitCostCents  Int      @default(0)
  sellPriceCents Int?
  stockOnHand    Int      @default(0)
  reorderPoint   Int      @default(0)
  supplierId     String?  @db.Uuid
  location       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  poLines  PurchaseOrderLine[]
  usages   PartUsage[]

  @@index([supplierId])
}

model PurchaseOrder {
  id         String    @id @default(uuid()) @db.Uuid
  reference  String    @unique
  supplierId String    @db.Uuid
  status     String    @default("DRAFT")
  totalCents Int       @default(0)
  notes      String?
  orderedAt  DateTime?
  receivedAt DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  partId          String @db.Uuid
  qty             Int
  unitCostCents   Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id])

  @@index([purchaseOrderId])
  @@index([partId])
}

model PartUsage {
  id               String   @id @default(uuid()) @db.Uuid
  bookingReference String
  partId           String   @db.Uuid
  qty              Int
  unitCostCents    Int
  recordedBy       String?
  createdAt        DateTime @default(now())

  part Part @relation(fields: [partId], references: [id])

  @@index([partId])
  @@index([createdAt])
}

// QuickBooks finance integration (2026-11-11), BUILT DARK: the deployed
// API holds no Intuit credentials and cannot call QuickBooks itself.
// Pepper's QuickBooks connector syncs real company data through the
// owner-only POST /finance/sync into these mirror tables; every finance
// surface reads them and stamps the sync time. Until a first sync lands,
// FinanceConnection has no row and the honest status is not_connected.
model FinanceConnection {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @unique @default("quickbooks")
  status      String    @default("not_connected")
  companyName String?
  realmHint   String?
  lastSyncAt  DateTime?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FinanceSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String
  periodLabel String
  payload     Json
  source      String   @default("quickbooks-connector")
  syncedAt    DateTime @default(now())

  @@unique([kind, periodLabel])
  @@index([kind])
}

model FinanceInvoiceMirror {
  id           String    @id @default(uuid()) @db.Uuid
  qbId         String    @unique
  number       String?
  customerName String?
  totalCents   Int       @default(0)
  balanceCents Int       @default(0)
  status       String?
  dueDate      DateTime?
  qbUrl        String?
  syncedAt     DateTime  @default(now())

  @@index([balanceCents])
}
