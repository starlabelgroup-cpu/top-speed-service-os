// Top Speed Service OS — canonical Phase 1 Prisma schema.
// Company is the tenant boundary (companyId). IDs are UUIDs and money uses Decimal(10, 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  PLATFORM_ADMIN
  COMPANY_OWNER
  COMPANY_ADMIN
  DISPATCHER
  CUSTOMER
  PROVIDER_OWNER
  PROVIDER_TECH
  TECHNICIAN
  ADVERTISER
  MARKETING_MANAGER
  DEVELOPER
  AD_SPECIALIST
  CONTENT_CREATOR
}

enum CompanyType {
  PLATFORM_OWNER
  NETWORK_BUSINESS
  INDEPENDENT_PROVIDER
  CUSTOMER_COMPANY
}

enum BookingStatus {
  PENDING_DISPATCH
  MATCH_PENDING_APPROVAL
  CONFIRMED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeeStatus {
  COLLECTED_AT_BOOKING
  NOT_COLLECTED
  REFUNDED
}

enum DispatchMode {
  HYBRID
  MANUAL
  AUTOMATIC
}

enum AssignmentStatus {
  PROPOSED
  APPROVED
  ACCEPTED
  NOT_SELECTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ProviderType {
  NETWORK_BUSINESS
  INDEPENDENT_PROVIDER
  INTERNAL_TEAM
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  VOID
}

model Company {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  slug            String      @unique
  type            CompanyType
  isPlatformOwner Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  users                   User[]
  customers               Customer[]
  serviceRequests         ServiceRequest[]
  dispatchAssignments     DispatchAssignment[]
  providers               Provider[]
  invoices                Invoice[]
  referrals               Referral[]
  referralJourneys        ReferralJourney[]
  referralCredits         ReferralCredit[]
  referralProgramSettings ReferralProgramSetting[]
  dispatchSettings        DispatchSetting[]
  notificationOutbox      NotificationOutbox[]
  videoRequests           VideoConsultRequest[]
  payments                Payment[]
  channelLinks            ChannelLink[]

  @@index([type])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  email        String
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  roles        Role[]
  active       Boolean  @default(true)
  // Email verification (2026-11-12): set when the account holder clicks
  // the single-use verification link; null means "not verified yet" —
  // a soft prompt everywhere, never a lockout.
  emailVerifiedAt DateTime?
  // Signup attribution: where the account came from. signupSource is
  // 'OFFER_PAGE' for offer-page sign-ups (signupOfferSlug names the
  // offer) and 'ACCOUNT_SIGNUP' for the plain register surfaces.
  // signupAudience is 'homeowner' | 'commercial' | 'property-manager'.
  signupSource    String?
  signupOfferSlug String?
  signupAudience  String?
  // Profile-completion service address, resolved through the Service
  // Book area model (config/serviceAreas resolveArea) at save time.
  serviceStreet     String?
  serviceCity       String?
  serviceZip        String?
  serviceArea       String?
  serviceAreaStatus String?
  // Speedy Verify (2026-11-16, Phase 1): the per-account activation
  // switch for the Master's access-code system. Default false — every
  // account that existed at launch is grandfathered (password-only
  // sign-in, unchanged). The Master turns it on per account (issuing
  // the account's first code turns it on automatically); new staff and
  // business accounts are created with it on and wait for his code.
  verifyRequired Boolean @default(false)
  // Layer 2 — 2-step sign-in (2026-11-16): after ANY first factor
  // (password or Google), a one-time 6-digit code by email or text
  // completes the sign-in. Default false — every account that existed
  // at launch is grandfathered (password-only, unchanged); NEW
  // accounts are created with it on (routes/auth.js). layer2Phone is
  // the text destination when it differs from the profile phone;
  // layer2Channel is the preferred channel ('EMAIL' | 'SMS'). The
  // Master (COMPANY_OWNER) is exempt by construction (Rule Zero) —
  // services/layer2.js short-circuits before any flag is read.
  layer2Required Boolean @default(false)
  layer2Phone    String?
  layer2Channel  String?
  // Tech settings (2026-11-19, Directive 6): per-account field-tech
  // settings that have no shared record to live on — vehicle,
  // notification preferences, and a company tech's personal service
  // areas / appliances (the company crew shares ONE provider record,
  // which the office manages). Network providers keep their areas /
  // appliances on their own Provider record instead. Shape:
  // { vehicle: {year, make, model, color, plate} | null,
  //   notifications: {jobOffers, scheduleChanges, payments, messages},
  //   myAreas: string[], myAppliances: string[] }
  techSettings   Json?
  // Employee number (Work Time Account Access, 2026-11-17): permanent,
  // unique, never reused — 'TS-' + sequential number starting at
  // TS-1001, assigned server-side at creation to EMPLOYEE accounts
  // (Service Setters, Managers, Providers/Techs, other staff). Null for
  // customer / business / PM / advertiser accounts, and null on the
  // Master account (COMPANY_OWNER displays "MASTER" instead).
  employeeNumber String? @unique
  // Temporary passwords (2026-11-17): the office (Master, via Work Time
  // Account Access) can issue a TEMPORARY password for any account.
  // The holder signs in with it, passes the same gates as always
  // (Speedy Verify, then Layer 2), and is then FORCED to set their own
  // password — no session exists until they do, and the temporary
  // password dies at that moment. tempPasswordHash is a scrypt hash
  // (services/passwords format); the plain temporary password is shown
  // to the Master exactly once at issue and never stored or logged.
  // mustChangePassword marks an account mid-flow. tempFailedAttempts /
  // tempLockedUntil give the temporary credential the platform's
  // lockout discipline (5 wrong → 15 minutes, mirroring Speedy
  // Verify). tempChangeJti is the single-use id of the live
  // change-token the completed sign-in pipeline hands out.
  // tempIssuedAt / tempIssuedById / passwordChangedAt are the office's
  // audit trail, surfaced as status chips in Work Time. The Master
  // account is exempt by construction (Rule Zero): issuance to a
  // COMPANY_OWNER account is refused and login never temp-gates him.
  tempPasswordHash      String?
  tempPasswordExpiresAt DateTime?
  mustChangePassword    Boolean   @default(false)
  tempIssuedAt          DateTime?
  tempIssuedById        String?   @db.Uuid
  tempFailedAttempts    Int       @default(0)
  tempLockedUntil       DateTime?
  tempChangeJti         String?
  passwordChangedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  channelLinks ChannelLink[]

  sellerChannelConnections SellerChannelConnection[]
  sellerChannelAudits      SellerChannelAudit[]

  adProviderAudits AdProviderAudit[]

  pepperReports PepperReport[]

  advertiserSubscription AdvertiserSubscription?

  authHandoffs AuthHandoff[]
  sessionHandoffs SessionHandoff[]

  emailVerificationTokens EmailVerificationToken[]

  passwordResetTokens PasswordResetToken[]

  emailChangeTokens EmailChangeToken[]

  pushSubscriptions PushSubscription[]

  termsAcceptances TermsAcceptance[]

  speedyVerifyCode SpeedyVerifyCode?

  loginChallenges LoginChallenge[]

  creatorContent MediaContent[] @relation("MediaContentOwner")

  @@unique([companyId, email])
  @@index([companyId])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  userId         String?  @db.Uuid
  source         String?
  referredByCode String?
  name           String
  phone          String
  email          String?
  address        String?
  city           String
  zip            String
  // Top Speed CRM pipeline + status flag (2026-11-19): the staff-set
  // CRM status flag — PRIORITY or FOLLOW_UP; null means Active (the
  // ordinary state, never stored as a string). Set only from the CRM
  // console (POST /crm/customers/:id/flag); no intake or booking flow
  // writes it. Lifetime value is NOT stored — it is computed at read
  // time from real money (PAID Payment rows + recorded receipts).
  crmFlag        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  invoices        Invoice[]

  @@index([companyId])
  @@index([companyId, phone])
}

// The booking record exposed by the API as /bookings.
model ServiceRequest {
  id                                String        @id @default(uuid()) @db.Uuid
  companyId                         String        @db.Uuid
  customerId                        String        @db.Uuid
  city                              String
  zip                               String
  appliance                         String
  issue                             String
  preferredWindow                   String?
  // Live arrival-window picker (2026-11-20, recommendation A1): the
  // service day (YYYY-MM-DD) the customer picked alongside
  // preferredWindow on the booking form / in the app / with Speedy.
  // A stated preference only — the appointment itself is still set by
  // a Service Setter through Book OS exactly as before. Null on every
  // booking made before the picker (and any client that sends none).
  preferredDate                     String?
  referenceCode                     String?       @unique
  source                            String        @default("WEBSITE")
  // Intake attribution (2026-11-12, Fusion absorb Stage 3): the landing
  // page a lead came from, the [via:] surface tag, and the UTM campaign
  // fields. All optional — bookings made before this change (and any
  // client that sends none) simply carry nulls.
  sourcePage                        String?
  viaTag                            String?
  utmSource                         String?
  utmMedium                         String?
  utmCampaign                       String?
  // Top Speed Ads click IDs (2026-11-17): the platform click
  // identifiers a paid click carries into the landing page (Google
  // gclid, Meta fbclid, Microsoft msclkid), captured first-touch by
  // the client and stored beside the UTM fields. All optional — a
  // booking that arrived without one simply carries nulls.
  gclid                             String?
  fbclid                            String?
  msclkid                           String?
  // ApplianceReferral attribution (2026-11-12, Phase 1): the personal
  // TS-REF-XXXX code this booking arrived through, and the referrer's
  // customer id. Persisted so a referred booking stays attributable
  // across cold starts (before this, the linkage lived only in memory).
  referralCode                      String?
  referredByCustomerId              String?       @db.Uuid
  // Top Speed CRM — Service Book area model (2026-11-12): the booking's
  // service address resolved into the platform's 12-area model at
  // intake (see config/serviceAreas.js resolveArea). areaStatus is
  // IN_AREA / AREA_REVIEW (covered ZIP, ambiguous area — a setter
  // resolves it) / OUT_OF_AREA (recorded on the expansion waitlist,
  // never promised service). serviceAddress snapshots the address the
  // job was booked at, so a customer who moves keeps per-job addresses.
  area                              String?
  areaStatus                        String        @default("IN_AREA")
  serviceAddress                    String?
  // Working-state documents the API services operate on. The relational
  // core (customer, status, fee, assignments) stays in columns/tables;
  // these JSON columns carry the booking's event history, its dispatch
  // state, and its Book OS appointment exactly as the services produce them.
  history                           Json          @default("[]")
  dispatch                          Json?
  appointment                       Json?
  completedAt                       DateTime?
  completedBy                       String?
  status                            BookingStatus @default(PENDING_DISPATCH)
  diagnosticFee                     Decimal       @default(99.00) @db.Decimal(10, 2)
  diagnosticFeeCreditedTowardRepair Boolean       @default(true)
  feeStatus                         FeeStatus     @default(COLLECTED_AT_BOOKING)
  // Service Setters priority tier (2026-11-17, Operations Blueprint §5):
  // P1 critical commercial failure · P2 urgent household loss of
  // essential function or active leak · P3 routine repair · P4 planned
  // installation or maintenance. Nullable on purpose: an unset tier is
  // derived at read time (installations → P4, everything else → P3);
  // a value stored here is a tier a setter deliberately set, and it
  // wins over the derivation. Derivation lives in
  // services/dispatchOps.js (priorityTierOf).
  priorityTier                      String?
  createdAt                         DateTime      @default(now())
  updatedAt                         DateTime      @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  dispatchAssignments DispatchAssignment[]
  invoices            Invoice[]
  payments            Payment[]
  trackingTokens      TrackingToken[]
  estimateApprovalTokens EstimateApprovalToken[]

  @@index([companyId, status])
  @@index([companyId, zip])
  @@index([companyId, area])
  @@index([companyId, areaStatus])
}

// Top Speed CRM staff notes (2026-11-12): free-text notes the team keeps
// on a customer record, shown in the CRM customer 360. Plain columns in
// the Connection style — the note's customer/company ids are the record.
model CrmNote {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  customerId String   @db.Uuid
  author     String
  body       String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([companyId])
}

// Book OS Inbox (2026-11-16): every email the platform receives through
// the Resend inbound webhook (service@ forwards a copy of every message
// to the Resend receiving address), plus the staff replies sent back
// out through Resend. One row per message, direction INBOUND or
// OUTBOUND; an outbound reply points at the inbound row it answers via
// threadRootId. Plain columns in the CrmNote style — no FK relations,
// the row's customerId / connectionId are the record. customerId is
// null for mail whose sender matches no CRM customer: the message is
// still queued (status UNREAD) so no customer mail is ever dropped.
// providerEmailId is the Resend email id and is unique per message so
// webhook retries dedupe instead of double-filing.
model InboxMessage {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  direction        String    @default("INBOUND")
  providerEmailId  String?   @unique
  fromEmail        String
  fromName         String?
  toEmail          String
  mailbox          String?
  subject          String
  textBody         String?
  htmlBody         String?
  snippet          String?
  customerId       String?   @db.Uuid
  connectionId     String?   @db.Uuid
  threadRootId     String?   @db.Uuid
  messageIdHeader  String?
  inReplyToHeader  String?
  status           String    @default("UNREAD")
  author           String?
  receivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, status, createdAt])
  @@index([companyId, mailbox, createdAt])
  @@index([customerId, createdAt])
  @@index([threadRootId])
}

model Provider {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @db.Uuid
  businessName  String
  type          ProviderType
  specialties   String[]
  serviceCities String[]
  rating        Decimal?     @db.Decimal(3, 2)
  active        Boolean      @default(true)
  // Two tech systems (2026-11-19): true only for Top Speed's own field
  // team — its accounts sign in at the Company Tech door; every other
  // provider belongs to the Service Network door.
  companyCrew   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dispatchAssignments DispatchAssignment[]
  vanStock            VanStock[]

  @@index([companyId])
  @@index([active])
}

model DispatchAssignment {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @db.Uuid
  serviceRequestId  String           @db.Uuid
  providerId        String           @db.Uuid
  status            AssignmentStatus @default(PROPOSED)
  dispatchMode      DispatchMode     @default(HYBRID)
  approvalRequired  Boolean          @default(true)
  matchScore        Int?
  providerCompanyId String?          @db.Uuid
  approvedById      String?
  approvedByName    String?
  approvedAt        DateTime?
  // Track My Tech live GPS: the technician device's latest reported
  // position for this assignment (only ever set by a real device report).
  lastLat           Float?
  lastLng           Float?
  lastLocationAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([serviceRequestId])
  @@index([providerId])
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @db.Uuid
  serviceRequestId String        @db.Uuid
  customerId       String        @db.Uuid
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @default(0.00) @db.Decimal(10, 2)
  diagnosticFee    Decimal       @default(99.00) @db.Decimal(10, 2)
  diagnosticCredit Decimal       @default(99.00) @db.Decimal(10, 2)
  total            Decimal       @default(0.00) @db.Decimal(10, 2)
  currency         String        @default("USD")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([serviceRequestId])
}

// Flywheel persistence (2026-11-09): referral codes and the notification
// outbox move from the in-memory store to the database so they survive
// cold starts. Redemptions and payloads ride in JSON columns in exactly
// the shapes the services produce; the relational core stays in columns.
model Referral {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @db.Uuid
  code                    String
  // Referral track (Phase 2, 2026-11-12): CUSTOMER for household
  // referrers, PARTNER for business / property-manager referrers (codes
  // issued from commercial bookings, or staff-flagged in Book OS). One
  // program, one settings row — the track only separates reporting.
  track                   String   @default("CUSTOMER")
  customerId              String?  @db.Uuid
  customerName            String?
  customerPhone           String?
  status                  String   @default("ACTIVE")
  issuedFromBookingId     String?  @db.Uuid
  issuedFromReferenceCode String?
  redemptions             Json     @default("[]")
  clickCount              Int      @default(0)
  issuedAt                DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journeys ReferralJourney[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ApplianceReferral rewards program (2026-11-12, Phase 1): the lifecycle
// of one referred friend, from invite to reward. status is a free-form
// String, matching Referral: INVITED | CLICKED | BOOKED | COMPLETED |
// REWARD_PENDING_APPROVAL | REWARD_APPROVED | CREDIT_ISSUED | REDEEMED |
// REJECTED | EXPIRED | VOID. rewardAmountCents is a SNAPSHOT copied from
// the program settings at completion time — null until a figure is
// configured, and never published from anywhere else.
model ReferralJourney {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  referralId         String    @db.Uuid
  code               String
  referrerCustomerId String?   @db.Uuid
  refereeName        String?
  refereePhone       String?
  refereeEmail       String?
  bookingId          String?   @db.Uuid
  bookingReference   String?
  // Track snapshot copied from the referral code when the journey is
  // created (Phase 2) — staff reporting filters on this, so re-flagging
  // a code never rewrites history.
  track              String    @default("CUSTOMER")
  status             String    @default("INVITED")
  rewardAmountCents  Int?
  tierSnapshot       String?
  staffDecisionBy    String?
  staffDecisionAt    DateTime?
  staffNote          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  referral Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  credits  ReferralCredit[]

  @@index([companyId, code])
  @@index([companyId, status])
  @@index([companyId, refereePhone])
  @@index([companyId, track, status])
}

// A reward credit issued to a referrer after staff approval. The ledger
// record: credits are real money-equivalents, so issuance is staff-only
// and every state change is recorded (issuer, redemption booking).
model ReferralCredit {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  customerId        String    @db.Uuid
  journeyId         String    @db.Uuid
  amountCents       Int
  status            String    @default("AVAILABLE")
  issuedBy          String
  expiresAt         DateTime?
  redeemedBookingId String?   @db.Uuid
  redeemedReference String?
  redeemedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journey ReferralJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([journeyId])
}

// Referral program configuration, one row per company. A dedicated typed
// model — the boolean-only NotificationSetting table cannot hold amounts.
// rewardAmountCents NULL means UNSET: nothing anywhere may publish or pay
// a referrer-reward figure until the owner configures one here.
model ReferralProgramSetting {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @unique @db.Uuid
  enabled               Boolean  @default(true)
  rewardAmountCents     Int?
  tier2Threshold        Int?
  tier2AmountCents      Int?
  tier3Threshold        Int?
  tier3AmountCents      Int?
  milestoneBonuses      Json?
  monthlyCapPerReferrer Int?
  rewardExpiryDays      Int?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Service Setters capacity planning (2026-11-17, Operations Blueprint
// §7): the office's own planning inputs for the daily booking ceiling —
// ceiling = technicians × workingHoursPerTech × 60 × (1 − buffer/100)
// ÷ minutesPerJob. One row per company; a missing row means the
// blueprint defaults (25% buffer, 120 minutes per job incl. travel,
// 8 working hours). These are planning estimates the office tunes —
// they never block a booking by themselves.
model DispatchSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @unique @db.Uuid
  bufferPercent      Int      @default(25)
  minutesPerJob      Int      @default(120)
  workingHoursPerDay Float    @default(8)
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model NotificationOutbox {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  channel    String
  template   String
  to         String
  payload    Json      @default("{}")
  status     String    @default("QUEUED_SIMULATED")
  eventKey   String?   @unique
  eventType  String?
  reason     String?
  attempts   Int       @default(0)
  provider   String?
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([createdAt])
}

// Unified notifications system (2026-11-11): staff toggles for the
// alerts pipeline — staff email alerts, staff SMS alerts, customer
// email/SMS confirmations. Key/value rows; a missing row means the
// ALL-ON default in services/notifications.js.
model NotificationSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  enabled   Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Speedy Live Video (2026-11-09): a customer asks to show the problem
// live; Service Setters arrange it — immediate, scheduled, or
// manager-assisted — and the request gets a video room both sides join.
model VideoConsultRequest {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  customerName     String
  phone            String
  appliance        String
  note             String?
  bookingReference String?
  mode             String   @default("UNDECIDED")
  status           String   @default("PENDING")
  roomName         String?  @unique
  arrangedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

/**
 * A customer payment collected through Stripe — the payment ledger.
 * One row per Checkout session attempt. The webhook flips PENDING →
 * PAID; `diagnosticPaid` everywhere in the API is derived from a PAID
 * row for the booking, so this table is the single source of truth
 * for money received online (the feeStatus column on ServiceRequest
 * remains the office's manual bookkeeping).
 */
model Payment {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @db.Uuid
  serviceRequestId      String    @db.Uuid
  customerId            String?   @db.Uuid
  purpose               String    @default("DIAGNOSTIC")
  amountCents           Int
  currency              String    @default("usd")
  status                String    @default("PENDING")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  checkoutUrl           String?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([serviceRequestId])
}

// One row per ad-channel connection an advertiser-console user has
// requested or completed (Google Ads, Meta, TikTok, ...). The link itself
// is completed by the team (manager-account link / partner access), so a
// row starts PENDING_LINK and staff flip it to CONNECTED. This table is
// the connect system's record; live metrics sync arrives with each
// platform's API approval.
model ChannelLink {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  userId     String   @db.Uuid
  channel    String
  accountRef String
  status     String   @default("PENDING_LINK")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([companyId, status])
}

model Connection {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  phone       String
  email       String?
  type        String
  source      String?
  message     String?
  // Intake attribution (2026-11-12, Fusion absorb Stage 3) — same
  // capture as ServiceRequest: landing page, [via:] tag, UTM fields.
  sourcePage  String?
  viaTag      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  // Top Speed Ads click IDs (2026-11-17) — same columns as
  // ServiceRequest; the shared attribution layer flattens both.
  gclid       String?
  fbclid      String?
  msclkid     String?
  reference   String   @unique
  // Top Speed CRM Leads & Pipeline (2026-11-19): the stage a Service
  // Setter deliberately set on this lead (NEW / CONTACTED / ESTIMATE /
  // WON / LOST). Null means "no human has staged this lead" — the
  // pipeline board then DERIVES the stage from the linked booking
  // (completed or fully paid → WON, an estimate on file → ESTIMATE,
  // otherwise NEW). A stored stage always wins over the derivation.
  // Only lead-type connections (services/leadBookings.js LEAD_TYPES)
  // appear on the board; the column is inert on every other type.
  pipelineStage String?
  createdAt   DateTime @default(now())
}

// Service OS Insights (2026-11-17): PageSpeed Insights snapshots for the
// portfolio homepages, taken by the staff-triggered refresh on
// /insights. One row per fetch attempt — failures are stored too
// (status ERROR + the error text), so a site whose hosting is down
// shows its failure honestly instead of a stale or invented score.
model InsightsPageSpeedSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  strategy  String   @default("mobile")
  status    String   @default("OK")
  score     Float?
  lcpMs     Float?
  cls       Float?
  inpMs     Float?
  error     String?
  fetchedAt DateTime @default(now())

  @@index([url, fetchedAt])
}

model CustomerAppliance {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  type        String
  brand       String?
  model       String?
  serial      String?
  year        Int?
  notes       String?
  createdAt   DateTime             @default(now())
  connections ApplianceConnection[]
  events      ApplianceEvent[]
}

// Connected-appliance foundation (2026-11-19, Ramone's order — the
// Smart Home Connect takeaway): the registry of manufacturer-network
// connections a customer consents to for one of their garage
// appliances, plus the event table manufacturer fault/status events
// will land in once a brand integration exists. Providers:
// HOME_CONNECT (Bosch/Siemens/Thermador), SMARTTHINGS (Samsung),
// THINQ (LG), SMARTHQ (GE), OTHER. Status vocabulary: REGISTERED
// (customer consented; recorded on their account — NO manufacturer
// link exists yet), LINKED (a live manufacturer link — part of the
// vocabulary for the future brand integrations; NO code path in the
// foundation build may set it), REVOKED (customer withdrew consent;
// the end state — re-registering creates a fresh row). externalId
// stays NULL until a real manufacturer link writes it.
model ApplianceConnection {
  id         String            @id @default(uuid()) @db.Uuid
  applianceId String           @db.Uuid
  appliance  CustomerAppliance @relation(fields: [applianceId], references: [id], onDelete: Cascade)
  provider   String
  externalId String?
  status     String            @default("REGISTERED")
  consentAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  events     ApplianceEvent[]

  @@index([applianceId])
  @@index([provider, status])
}

// One manufacturer event for a connected appliance (fault codes,
// status changes) as received from the brand's cloud. Written ONLY
// by a future brand integration — the foundation build ships the
// table and its read side; there is no ingestion endpoint and no
// seeded event anywhere.
model ApplianceEvent {
  id           String              @id @default(uuid()) @db.Uuid
  applianceId  String              @db.Uuid
  appliance    CustomerAppliance   @relation(fields: [applianceId], references: [id], onDelete: Cascade)
  connectionId String?             @db.Uuid
  connection   ApplianceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  type         String
  source       String
  payload      Json?
  receivedAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())

  @@index([applianceId])
  @@index([connectionId])
}

// Pepper Lists Speedy Brain (2026-11-16): the actual photo/video bytes
// a signed-in customer sends to the Service Setters with a scan & send
// submission. One row per media item, keyed to the Connection record
// the submission created; the setter queue booking carries the facts
// and the manifest, staff fetch the media itself through the staff-
// gated pepper-lists media endpoint. Bytes are stored as a data URL
// (the same shape the vision endpoints already accept), size-capped
// at the route: photos 6 MB, videos 15 MB, 4 items per submission.
model SubmissionMedia {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @db.Uuid
  kind         String
  mime         String
  sizeBytes    Int
  dataUrl      String
  createdAt    DateTime @default(now())

  @@index([connectionId])
}

// Pepper Lists Reviews (2026-11-16): customer reviews of completed
// repairs, posted from inside the signed-in Pepper Lists app with
// photos/videos and an optional post-service survey. Speedy (the AI
// assistant) is the first responder on every review and comment:
// positive reviews publish automatically with a Speedy thank-you;
// anything flagged (rating <= 3 or a complaint keyword) stays PENDING
// for the office, escalated, with a holding reply that promises
// nothing — refunds and compensation are human decisions only
// (services/speedyPolicy.js). Like SubmissionMedia above, the id
// columns are plain references (no FK relations): the working set is
// the in-memory store with write-through persistence, and a review
// must never fail to save because a referenced row lives only in
// memory. bookingId references a ServiceRequest (the booking record).
model Review {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  customerId       String    @db.Uuid
  bookingId        String?   @db.Uuid
  rating           Int
  title            String
  body             String
  status           String    @default("PENDING")
  verifiedRepair   Boolean   @default(false)
  escalated        Boolean   @default(false)
  escalationReason String?
  speedyReply      String?
  speedyReplyAt    DateTime?
  speedyReplyMode  String?
  survey           Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([bookingId])
}

// One photo/video attached to a review. Bytes are stored raw (Bytes),
// capped at the route: photos 6 MB, videos 15 MB, 4 items per review,
// magic-byte validated. Public serving is restricted to media of
// PUBLISHED reviews; staff and the review's owner use gated routes.
model ReviewMedia {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @db.Uuid
  kind      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([reviewId])
}

// One message in a review thread. authorKind is CUSTOMER (the review's
// owner), SPEEDY (the AI responder — also mirrored onto the Review's
// speedyReply fields when it is the review-level reply) or STAFF (the
// office, shown to the customer as "Top Speed Appliance — Office").
model ReviewComment {
  id         String   @id @default(uuid()) @db.Uuid
  reviewId   String   @db.Uuid
  authorId   String?  @db.Uuid
  authorKind String
  body       String
  createdAt  DateTime @default(now())

  @@index([reviewId, createdAt])
}

model Banner {
  id             String   @id @default(uuid()) @db.Uuid
  placement      String   @default("FOOTER")
  advertiserName String
  headline       String
  copy           String?
  imageUrl       String?
  ctaText        String?
  ctaUrl         String
  active         Boolean  @default(true)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Secure per-job customer tracking links (Track My Tech, 2026-11-11):
// only the SHA-256 hash of the token is stored; the raw token exists
// solely in the link given to the verified customer. Links expire and
// issuing a new link revokes the previous ones for that booking.
model TrackingToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  bookingId String    @db.Uuid
  issuedBy  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  booking ServiceRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// Super Apps cross-site sign-in handoff (2026-11-12): a signed-in customer
// moving between surfaces (flagship ↔ Connect Pro ↔ Appliance Pro ↔ the
// customer app) exchanges a one-time token instead of signing in again.
// Only the SHA-256 hash is stored; tokens are single-use, audience-bound,
// and expire five minutes after issue. Also backs the emailed sign-in
// link a .net booking customer can claim (audience-checked the same way).
model AuthHandoff {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  audience  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Multi-account session handoffs (2026-11-17): a fully signed-in account
// holder moving between platform HOSTS (topspeedserviceos.com ↔
// appliance-connect.vercel.app ↔ the other platform domains) exchanges a
// one-time code instead of signing in again on the far side. Codes are
// random 32-byte secrets; only the SHA-256 hash is stored. They are
// single-use and expire 60 seconds after issue. `sv` records whether the
// minting session had passed Speedy Verify, so the session minted at
// redemption carries identical claims (a verify-activated account's
// /auth/me check requires sv: true). Distinct from AuthHandoff above,
// which is audience-bound and backs the in-platform surface links and
// the emailed claim link.
model SessionHandoff {
  id        String    @id @default(uuid()) @db.Uuid
  codeHash  String    @unique
  userId    String    @db.Uuid
  sv        Boolean   @default(false)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Email verification (2026-11-12): one live token per account at a
// time. Same storage discipline as AuthHandoff — random 32-byte
// secret, only its SHA-256 hash at rest, single-use, expiring (24h).
// Verifying sets User.emailVerifiedAt; it never gates booking.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Password reset (2026-11-18): the self-serve forgot-password flow.
// Only the SHA-256 hash of the emailed token is ever stored (the same
// discipline as EmailVerificationToken); the raw token travels only in
// the reset link. Tokens live 30 minutes, are single-use, and issuing
// a new one supersedes every still-unused token for the account.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Username (email) change tokens (2026-11-20): the self-serve
// email-change flow. Only the SHA-256 hash of the emailed token is
// stored; the raw token travels only in the confirmation link sent
// to the NEW address. The row records the requested newEmail so the
// exchange can re-check it is still free at confirm time. Tokens
// live 30 minutes, are single-use, and issuing a new one supersedes
// every still-unused token for the account (the PasswordResetToken
// discipline).
model EmailChangeToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  newEmail  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Estimate approval links (2026-11-20, Wave 1 D3): the customer-facing
// approval page for a saved estimate. Only the SHA-256 hash of the
// link token is stored; the raw token travels only in the link staff
// send through the Link Center. One decision per link: `decision` is
// set exactly once (atomic claim), a newer estimate supersedes every
// outstanding link for the booking (supersededAt, plus the estimateId
// check at resolve time), and links live 7 days. The decision itself
// is recorded on the booking's history by the shared job-money
// recorder — this row only proves WHICH link carried it.
model EstimateApprovalToken {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  bookingId    String    @db.Uuid
  estimateId   String
  decision     String?
  declineNote  String?
  decidedAt    DateTime?
  supersededAt DateTime?
  expiresAt    DateTime
  createdBy    String?
  createdAt    DateTime  @default(now())

  booking ServiceRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([expiresAt])
}

// Intake shield (2026-11-19): durable per-IP rate-limit windows for
// the public intake endpoints (register, connections + PM bulk,
// guest booking, forgot-password). One row per (family, ip, fixed
// hourly window); the count is incremented atomically per attempt
// and windows older than the previous one are swept opportunistically
// by services/intakeShield.js. This table is the reason the limits
// hold across serverless instances — the older middleware buckets
// are per-process memory and reset on every cold start. It stores no
// submission content, only the caller's IP and a counter.
model IntakeRateWindow {
  id          String   @id @default(uuid()) @db.Uuid
  family      String
  ip          String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([family, ip, windowStart])
  @@index([windowStart])
}

// Speedy Verify (2026-11-16, Phase 1): the Master's access-code system.
// One record per account: the code itself is stored ONLY as a scrypt hash
// (the same format as User.passwordHash) — the plain 8-digit code exists
// solely on the Master's screen at the moment he issues it. status is
// ACTIVE | REVOKED; revoking denies sign-in immediately. failedAttempts /
// lockedUntil carry the code-entry lockout (5 wrong codes → 15 minutes).
// The Master account (COMPANY_OWNER) never needs a record to sign in —
// it is exempt by construction (Rule Zero).
model SpeedyVerifyCode {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  codeHash       String
  status         String    @default("ACTIVE")
  issuedById     String?   @db.Uuid
  issuedAt       DateTime  @default(now())
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Layer 2 — 2-step sign-in challenges (2026-11-16). One row per
// sign-in that passed its first factor on a Layer-2-required account:
// created when the challenge is issued (login / register / Google
// callback / Speedy Verify exchange), it carries the delivery channel
// once a code is sent, the scrypt hash of the 6-digit code (the plain
// code is never stored or logged), the send/attempt counters that
// enforce the resend cooldown, the 5-send cap, and the 5-attempt
// invalidation. status is PENDING | CONSUMED | INVALIDATED |
// SUPERSEDED. Rows are per-LOGIN (fresh code every sign-in) — unlike
// SpeedyVerifyCode, which is a per-ACCOUNT standing access code.
model LoginChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  channel    String?
  codeHash   String?
  status     String    @default("PENDING")
  attempts   Int       @default(0)
  sends      Int       @default(0)
  lastSentAt DateTime?
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Legal gate (2026-11-12): one row per document version a user has
// signed with a typed full name before account access. Current versions
// live in src/services/legalTerms.js (both documents at v1.0, effective
// 2026-11-12); a version bump makes old rows stop satisfying the gate,
// so re-acceptance is enforced by the status check, not by deleting rows.
model TermsAcceptance {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  document      String
  version       String
  signatureName String
  acceptedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, document, version])
  @@index([userId])
}

// ─── Top Speed Marketing OS (Phase 1 Foundation, 2026-11-11) ───
// The agency's data layer on the Service OS backend: the §3 taxonomy
// (cities / brands / services / symptoms), the Page Studio landing
// pages (§4 URL scheme), and a full version snapshot per content save
// (§12 draft/preview/publish workflow + revisions). Expansion cities
// are records only — the publish path refuses non-covered cities.

enum LandingPageType {
  CITY
  BRAND
  SERVICE
  BRAND_SERVICE
  BRAND_SERVICE_CITY
}

enum LandingPageStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  UNPUBLISHED
}

enum MediaContentType {
  VIDEO
  ARTICLE
  SOCIAL_POST
  LIVE
  IMAGE
}

enum MediaContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaDivision {
  VIDEOS
  PUBLISHING
  NEWS
  SOCIAL
  LIVE
}

enum MediaAssetRightsStatus {
  OWNED
  LICENSED
  PENDING_REVIEW
}

model MarketingCity {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  slug           String   @unique
  state          String   @default("FL")
  serviceCovered Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pages LandingPage[]
}

model MarketingBrand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages LandingPage[]
}

model MarketingService {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  slug          String   @unique
  // Slug of the canonical service this entry is scoped inside
  // (Cooktop -> oven-range-repair); null for standalone services.
  partOfService String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pages LandingPage[]
}

model MarketingSymptom {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPage {
  id              String            @id @default(uuid()) @db.Uuid
  type            LandingPageType
  cityId          String?           @db.Uuid
  brandId         String?           @db.Uuid
  serviceId       String?           @db.Uuid
  slug            String
  canonicalUrl    String            @unique
  title           String
  metaDescription String?
  status          LandingPageStatus @default(DRAFT)
  sections        Json              @default("[]")
  createdBy       String?
  updatedBy       String?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  city     MarketingCity?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  brand    MarketingBrand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  service  MarketingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  versions PageVersion[]

  @@index([status, type])
  @@index([cityId])
  @@index([brandId])
  @@index([serviceId])
}

model PageVersion {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  version   Int
  snapshot  Json
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  page LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId])
}

// Parts Supply OS (2026-11-11): suppliers, parts inventory, purchase
// orders and per-job parts usage. Operations data — staff only at the
// API. Usage snapshots the part's unit cost at the moment of use so job
// costing survives later price changes.
enum SupplierVendorType {
  STANDARD
  PARTNER_DISTRIBUTOR
}

model Supplier {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  contact    String?
  phone      String?
  email      String?
  terms      String?
  vendorType SupplierVendorType @default(STANDARD)
  active     Boolean            @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts          Part[]
  purchaseOrders PurchaseOrder[]
}

model Part {
  id             String   @id @default(uuid()) @db.Uuid
  sku            String   @unique
  name           String
  category       String
  brand          String?
  unitCostCents  Int      @default(0)
  sellPriceCents Int?
  stockOnHand    Int      @default(0)
  reorderPoint   Int      @default(0)
  supplierId     String?  @db.Uuid
  location       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  poLines  PurchaseOrderLine[]
  usages   PartUsage[]
  vanStock VanStock[]

  @@index([supplierId])
}

model PurchaseOrder {
  id         String    @id @default(uuid()) @db.Uuid
  reference  String    @unique
  supplierId String    @db.Uuid
  status     String    @default("DRAFT")
  totalCents Int       @default(0)
  notes      String?
  orderedAt  DateTime?
  receivedAt DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  partId          String @db.Uuid
  qty             Int
  unitCostCents   Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id])

  @@index([purchaseOrderId])
  @@index([partId])
}

model PartUsage {
  id               String   @id @default(uuid()) @db.Uuid
  bookingReference String
  partId           String   @db.Uuid
  qty              Int
  unitCostCents    Int
  recordedBy       String?
  createdAt        DateTime @default(now())

  part Part @relation(fields: [partId], references: [id])

  @@index([partId])
  @@index([createdAt])
}

// Tech Pro van stock (2026-11-17, from the Top Speed Tech Pro field
// guide): the parts a provider's technicians physically carry on the
// van. The Parts Supply OS catalog (Part) stays the system of record
// for what a part IS; a VanStock row says how many of it this provider
// has on the truck. Allocating a part to a job decrements the van row
// and writes a PartUsage (the installed record) — the van can never go
// negative. Set/read through the provider-gated Tech App routes only.
model VanStock {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  partId     String   @db.Uuid
  qty        Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  part     Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([providerId, partId])
  @@index([providerId])
}

// QuickBooks finance integration (2026-11-11), BUILT DARK: the deployed
// API holds no Intuit credentials and cannot call QuickBooks itself.
// Pepper's QuickBooks connector syncs real company data through the
// owner-only POST /finance/sync into these mirror tables; every finance
// surface reads them and stamps the sync time. Until a first sync lands,
// FinanceConnection has no row and the honest status is not_connected.
model FinanceConnection {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @unique @default("quickbooks")
  status      String    @default("not_connected")
  companyName String?
  realmHint   String?
  lastSyncAt  DateTime?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FinanceSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String
  periodLabel String
  payload     Json
  source      String   @default("quickbooks-connector")
  syncedAt    DateTime @default(now())

  @@unique([kind, periodLabel])
  @@index([kind])
}

model FinanceInvoiceMirror {
  id           String    @id @default(uuid()) @db.Uuid
  qbId         String    @unique
  number       String?
  customerName String?
  totalCents   Int       @default(0)
  balanceCents Int       @default(0)
  status       String?
  dueDate      DateTime?
  qbUrl        String?
  syncedAt     DateTime  @default(now())

  @@index([balanceCents])
