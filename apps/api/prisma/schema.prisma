// Top Speed Service OS — canonical Phase 1 Prisma schema.
// Company is the tenant boundary (companyId). IDs are UUIDs and money uses Decimal(10, 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  PLATFORM_ADMIN
  COMPANY_OWNER
  COMPANY_ADMIN
  DISPATCHER
  CUSTOMER
  PROVIDER_OWNER
  PROVIDER_TECH
  TECHNICIAN
  ADVERTISER
  MARKETING_MANAGER
  DEVELOPER
}

enum CompanyType {
  PLATFORM_OWNER
  NETWORK_BUSINESS
  INDEPENDENT_PROVIDER
  CUSTOMER_COMPANY
}

enum BookingStatus {
  PENDING_DISPATCH
  MATCH_PENDING_APPROVAL
  CONFIRMED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeeStatus {
  COLLECTED_AT_BOOKING
  NOT_COLLECTED
  REFUNDED
}

enum DispatchMode {
  HYBRID
  MANUAL
  AUTOMATIC
}

enum AssignmentStatus {
  PROPOSED
  APPROVED
  ACCEPTED
  NOT_SELECTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ProviderType {
  NETWORK_BUSINESS
  INDEPENDENT_PROVIDER
  INTERNAL_TEAM
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  VOID
}

model Company {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  slug            String      @unique
  type            CompanyType
  isPlatformOwner Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  users                   User[]
  customers               Customer[]
  serviceRequests         ServiceRequest[]
  dispatchAssignments     DispatchAssignment[]
  providers               Provider[]
  invoices                Invoice[]
  referrals               Referral[]
  referralJourneys        ReferralJourney[]
  referralCredits         ReferralCredit[]
  referralProgramSettings ReferralProgramSetting[]
  notificationOutbox      NotificationOutbox[]
  videoRequests           VideoConsultRequest[]
  payments                Payment[]
  channelLinks            ChannelLink[]

  @@index([type])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  email        String
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  roles        Role[]
  active       Boolean  @default(true)
  // Email verification (2026-11-12): set when the account holder clicks
  // the single-use verification link; null means "not verified yet" —
  // a soft prompt everywhere, never a lockout.
  emailVerifiedAt DateTime?
  // Signup attribution: where the account came from. signupSource is
  // 'OFFER_PAGE' for offer-page sign-ups (signupOfferSlug names the
  // offer) and 'ACCOUNT_SIGNUP' for the plain register surfaces.
  // signupAudience is 'homeowner' | 'commercial' | 'property-manager'.
  signupSource    String?
  signupOfferSlug String?
  signupAudience  String?
  // Profile-completion service address, resolved through the Service
  // Book area model (config/serviceAreas resolveArea) at save time.
  serviceStreet     String?
  serviceCity       String?
  serviceZip        String?
  serviceArea       String?
  serviceAreaStatus String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  channelLinks ChannelLink[]

  authHandoffs AuthHandoff[]

  emailVerificationTokens EmailVerificationToken[]

  termsAcceptances TermsAcceptance[]

  @@unique([companyId, email])
  @@index([companyId])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  userId         String?  @db.Uuid
  source         String?
  referredByCode String?
  name           String
  phone          String
  email          String?
  address        String?
  city           String
  zip            String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  invoices        Invoice[]

  @@index([companyId])
  @@index([companyId, phone])
}

// The booking record exposed by the API as /bookings.
model ServiceRequest {
  id                                String        @id @default(uuid()) @db.Uuid
  companyId                         String        @db.Uuid
  customerId                        String        @db.Uuid
  city                              String
  zip                               String
  appliance                         String
  issue                             String
  preferredWindow                   String?
  referenceCode                     String?       @unique
  source                            String        @default("WEBSITE")
  // Intake attribution (2026-11-12, Fusion absorb Stage 3): the landing
  // page a lead came from, the [via:] surface tag, and the UTM campaign
  // fields. All optional — bookings made before this change (and any
  // client that sends none) simply carry nulls.
  sourcePage                        String?
  viaTag                            String?
  utmSource                         String?
  utmMedium                         String?
  utmCampaign                       String?
  // ApplianceReferral attribution (2026-11-12, Phase 1): the personal
  // TS-REF-XXXX code this booking arrived through, and the referrer's
  // customer id. Persisted so a referred booking stays attributable
  // across cold starts (before this, the linkage lived only in memory).
  referralCode                      String?
  referredByCustomerId              String?       @db.Uuid
  // Top Speed CRM — Service Book area model (2026-11-12): the booking's
  // service address resolved into the platform's 12-area model at
  // intake (see config/serviceAreas.js resolveArea). areaStatus is
  // IN_AREA / AREA_REVIEW (covered ZIP, ambiguous area — a setter
  // resolves it) / OUT_OF_AREA (recorded on the expansion waitlist,
  // never promised service). serviceAddress snapshots the address the
  // job was booked at, so a customer who moves keeps per-job addresses.
  area                              String?
  areaStatus                        String        @default("IN_AREA")
  serviceAddress                    String?
  // Working-state documents the API services operate on. The relational
  // core (customer, status, fee, assignments) stays in columns/tables;
  // these JSON columns carry the booking's event history, its dispatch
  // state, and its Book OS appointment exactly as the services produce them.
  history                           Json          @default("[]")
  dispatch                          Json?
  appointment                       Json?
  completedAt                       DateTime?
  completedBy                       String?
  status                            BookingStatus @default(PENDING_DISPATCH)
  diagnosticFee                     Decimal       @default(99.00) @db.Decimal(10, 2)
  diagnosticFeeCreditedTowardRepair Boolean       @default(true)
  feeStatus                         FeeStatus     @default(COLLECTED_AT_BOOKING)
  createdAt                         DateTime      @default(now())
  updatedAt                         DateTime      @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  dispatchAssignments DispatchAssignment[]
  invoices            Invoice[]
  payments            Payment[]
  trackingTokens      TrackingToken[]

  @@index([companyId, status])
  @@index([companyId, zip])
  @@index([companyId, area])
  @@index([companyId, areaStatus])
}

// Top Speed CRM staff notes (2026-11-12): free-text notes the team keeps
// on a customer record, shown in the CRM customer 360. Plain columns in
// the Connection style — the note's customer/company ids are the record.
model CrmNote {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  customerId String   @db.Uuid
  author     String
  body       String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([companyId])
}

model Provider {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @db.Uuid
  businessName  String
  type          ProviderType
  specialties   String[]
  serviceCities String[]
  rating        Decimal?     @db.Decimal(3, 2)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dispatchAssignments DispatchAssignment[]

  @@index([companyId])
  @@index([active])
}

model DispatchAssignment {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @db.Uuid
  serviceRequestId  String           @db.Uuid
  providerId        String           @db.Uuid
  status            AssignmentStatus @default(PROPOSED)
  dispatchMode      DispatchMode     @default(HYBRID)
  approvalRequired  Boolean          @default(true)
  matchScore        Int?
  providerCompanyId String?          @db.Uuid
  approvedById      String?
  approvedByName    String?
  approvedAt        DateTime?
  // Track My Tech live GPS: the technician device's latest reported
  // position for this assignment (only ever set by a real device report).
  lastLat           Float?
  lastLng           Float?
  lastLocationAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([serviceRequestId])
  @@index([providerId])
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @db.Uuid
  serviceRequestId String        @db.Uuid
  customerId       String        @db.Uuid
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @default(0.00) @db.Decimal(10, 2)
  diagnosticFee    Decimal       @default(99.00) @db.Decimal(10, 2)
  diagnosticCredit Decimal       @default(99.00) @db.Decimal(10, 2)
  total            Decimal       @default(0.00) @db.Decimal(10, 2)
  currency         String        @default("USD")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([serviceRequestId])
}

// Flywheel persistence (2026-11-09): referral codes and the notification
// outbox move from the in-memory store to the database so they survive
// cold starts. Redemptions and payloads ride in JSON columns in exactly
// the shapes the services produce; the relational core stays in columns.
model Referral {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @db.Uuid
  code                    String
  // Referral track (Phase 2, 2026-11-12): CUSTOMER for household
  // referrers, PARTNER for business / property-manager referrers (codes
  // issued from commercial bookings, or staff-flagged in Book OS). One
  // program, one settings row — the track only separates reporting.
  track                   String   @default("CUSTOMER")
  customerId              String?  @db.Uuid
  customerName            String?
  customerPhone           String?
  status                  String   @default("ACTIVE")
  issuedFromBookingId     String?  @db.Uuid
  issuedFromReferenceCode String?
  redemptions             Json     @default("[]")
  clickCount              Int      @default(0)
  issuedAt                DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journeys ReferralJourney[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ApplianceReferral rewards program (2026-11-12, Phase 1): the lifecycle
// of one referred friend, from invite to reward. status is a free-form
// String, matching Referral: INVITED | CLICKED | BOOKED | COMPLETED |
// REWARD_PENDING_APPROVAL | REWARD_APPROVED | CREDIT_ISSUED | REDEEMED |
// REJECTED | EXPIRED | VOID. rewardAmountCents is a SNAPSHOT copied from
// the program settings at completion time — null until a figure is
// configured, and never published from anywhere else.
model ReferralJourney {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  referralId         String    @db.Uuid
  code               String
  referrerCustomerId String?   @db.Uuid
  refereeName        String?
  refereePhone       String?
  refereeEmail       String?
  bookingId          String?   @db.Uuid
  bookingReference   String?
  // Track snapshot copied from the referral code when the journey is
  // created (Phase 2) — staff reporting filters on this, so re-flagging
  // a code never rewrites history.
  track              String    @default("CUSTOMER")
  status             String    @default("INVITED")
  rewardAmountCents  Int?
  tierSnapshot       String?
  staffDecisionBy    String?
  staffDecisionAt    DateTime?
  staffNote          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  referral Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  credits  ReferralCredit[]

  @@index([companyId, code])
  @@index([companyId, status])
  @@index([companyId, refereePhone])
  @@index([companyId, track, status])
}

// A reward credit issued to a referrer after staff approval. The ledger
// record: credits are real money-equivalents, so issuance is staff-only
// and every state change is recorded (issuer, redemption booking).
model ReferralCredit {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  customerId        String    @db.Uuid
  journeyId         String    @db.Uuid
  amountCents       Int
  status            String    @default("AVAILABLE")
  issuedBy          String
  expiresAt         DateTime?
  redeemedBookingId String?   @db.Uuid
  redeemedReference String?
  redeemedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journey ReferralJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([journeyId])
}

// Referral program configuration, one row per company. A dedicated typed
// model — the boolean-only NotificationSetting table cannot hold amounts.
// rewardAmountCents NULL means UNSET: nothing anywhere may publish or pay
// a referrer-reward figure until the owner configures one here.
model ReferralProgramSetting {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @unique @db.Uuid
  enabled               Boolean  @default(true)
  rewardAmountCents     Int?
  tier2Threshold        Int?
  tier2AmountCents      Int?
  tier3Threshold        Int?
  tier3AmountCents      Int?
  milestoneBonuses      Json?
  monthlyCapPerReferrer Int?
  rewardExpiryDays      Int?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model NotificationOutbox {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  channel    String
  template   String
  to         String
  payload    Json      @default("{}")
  status     String    @default("QUEUED_SIMULATED")
  eventKey   String?   @unique
  eventType  String?
  reason     String?
  attempts   Int       @default(0)
  provider   String?
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([createdAt])
}

// Unified notifications system (2026-11-11): staff toggles for the
// alerts pipeline — staff email alerts, staff SMS alerts, customer
// email/SMS confirmations. Key/value rows; a missing row means the
// ALL-ON default in services/notifications.js.
model NotificationSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  enabled   Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Speedy Live Video (2026-11-09): a customer asks to show the problem
// live; Service Setters arrange it — immediate, scheduled, or
// manager-assisted — and the request gets a video room both sides join.
model VideoConsultRequest {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  customerName     String
  phone            String
  appliance        String
  note             String?
  bookingReference String?
  mode             String   @default("UNDECIDED")
  status           String   @default("PENDING")
  roomName         String?  @unique
  arrangedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

/**
 * A customer payment collected through Stripe — the payment ledger.
 * One row per Checkout session attempt. The webhook flips PENDING →
 * PAID; `diagnosticPaid` everywhere in the API is derived from a PAID
 * row for the booking, so this table is the single source of truth
 * for money received online (the feeStatus column on ServiceRequest
 * remains the office's manual bookkeeping).
 */
model Payment {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @db.Uuid
  serviceRequestId      String    @db.Uuid
  customerId            String?   @db.Uuid
  purpose               String    @default("DIAGNOSTIC")
  amountCents           Int
  currency              String    @default("usd")
  status                String    @default("PENDING")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  checkoutUrl           String?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([serviceRequestId])
}

// One row per ad-channel connection an advertiser-console user has
// requested or completed (Google Ads, Meta, TikTok, ...). The link itself
// is completed by the team (manager-account link / partner access), so a
// row starts PENDING_LINK and staff flip it to CONNECTED. This table is
// the connect system's record; live metrics sync arrives with each
// platform's API approval.
model ChannelLink {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  userId     String   @db.Uuid
  channel    String
  accountRef String
  status     String   @default("PENDING_LINK")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([companyId, status])
}

model Connection {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  phone       String
  email       String?
  type        String
  source      String?
  message     String?
  // Intake attribution (2026-11-12, Fusion absorb Stage 3) — same
  // capture as ServiceRequest: landing page, [via:] tag, UTM fields.
  sourcePage  String?
  viaTag      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  reference   String   @unique
  createdAt   DateTime @default(now())
}

model CustomerAppliance {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  brand     String?
  model     String?
  serial    String?
  year      Int?
  notes     String?
  createdAt DateTime @default(now())
}

model Banner {
  id             String   @id @default(uuid()) @db.Uuid
  placement      String   @default("FOOTER")
  advertiserName String
  headline       String
  copy           String?
  imageUrl       String?
  ctaText        String?
  ctaUrl         String
  active         Boolean  @default(true)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Secure per-job customer tracking links (Track My Tech, 2026-11-11):
// only the SHA-256 hash of the token is stored; the raw token exists
// solely in the link given to the verified customer. Links expire and
// issuing a new link revokes the previous ones for that booking.
model TrackingToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  bookingId String    @db.Uuid
  issuedBy  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  booking ServiceRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// Super Apps cross-site sign-in handoff (2026-11-12): a signed-in customer
// moving between surfaces (flagship ↔ Connect Pro ↔ Appliance Pro ↔ the
// customer app) exchanges a one-time token instead of signing in again.
// Only the SHA-256 hash is stored; tokens are single-use, audience-bound,
// and expire five minutes after issue. Also backs the emailed sign-in
// link a .net booking customer can claim (audience-checked the same way).
model AuthHandoff {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  audience  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Email verification (2026-11-12): one live token per account at a
// time. Same storage discipline as AuthHandoff — random 32-byte
// secret, only its SHA-256 hash at rest, single-use, expiring (24h).
// Verifying sets User.emailVerifiedAt; it never gates booking.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Legal gate (2026-11-12): one row per document version a user has
// signed with a typed full name before account access. Current versions
// live in src/services/legalTerms.js (both documents at v1.0, effective
// 2026-11-12); a version bump makes old rows stop satisfying the gate,
// so re-acceptance is enforced by the status check, not by deleting rows.
model TermsAcceptance {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  document      String
  version       String
  signatureName String
  acceptedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, document, version])
  @@index([userId])
}

// ─── Top Speed Marketing OS (Phase 1 Foundation, 2026-11-11) ───
// The agency's data layer on the Service OS backend: the §3 taxonomy
// (cities / brands / services / symptoms), the Page Studio landing
// pages (§4 URL scheme), and a full version snapshot per content save
// (§12 draft/preview/publish workflow + revisions). Expansion cities
// are records only — the publish path refuses non-covered cities.

enum LandingPageType {
  CITY
  BRAND
  SERVICE
  BRAND_SERVICE
  BRAND_SERVICE_CITY
}

enum LandingPageStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  UNPUBLISHED
}

enum MediaContentType {
  VIDEO
  ARTICLE
  SOCIAL_POST
  LIVE
  IMAGE
}

enum MediaContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaDivision {
  VIDEOS
  PUBLISHING
  NEWS
  SOCIAL
  LIVE
}

enum MediaAssetRightsStatus {
  OWNED
  LICENSED
  PENDING_REVIEW
}

model MarketingCity {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  slug           String   @unique
  state          String   @default("FL")
  serviceCovered Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pages LandingPage[]
}

model MarketingBrand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages LandingPage[]
}

model MarketingService {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  slug          String   @unique
  // Slug of the canonical service this entry is scoped inside
  // (Cooktop -> oven-range-repair); null for standalone services.
  partOfService String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pages LandingPage[]
}

model MarketingSymptom {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPage {
  id              String            @id @default(uuid()) @db.Uuid
  type            LandingPageType
  cityId          String?           @db.Uuid
  brandId         String?           @db.Uuid
  serviceId       String?           @db.Uuid
  slug            String
  canonicalUrl    String            @unique
  title           String
  metaDescription String?
  status          LandingPageStatus @default(DRAFT)
  sections        Json              @default("[]")
  createdBy       String?
  updatedBy       String?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  city     MarketingCity?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  brand    MarketingBrand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  service  MarketingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  versions PageVersion[]

  @@index([status, type])
  @@index([cityId])
  @@index([brandId])
  @@index([serviceId])
}

model PageVersion {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  version   Int
  snapshot  Json
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  page LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId])
}

// Parts Supply OS (2026-11-11): suppliers, parts inventory, purchase
// orders and per-job parts usage. Operations data — staff only at the
// API. Usage snapshots the part's unit cost at the moment of use so job
// costing survives later price changes.
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  contact   String?
  phone     String?
  email     String?
  terms     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts          Part[]
  purchaseOrders PurchaseOrder[]
}

model Part {
  id             String   @id @default(uuid()) @db.Uuid
  sku            String   @unique
  name           String
  category       String
  brand          String?
  unitCostCents  Int      @default(0)
  sellPriceCents Int?
  stockOnHand    Int      @default(0)
  reorderPoint   Int      @default(0)
  supplierId     String?  @db.Uuid
  location       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  poLines  PurchaseOrderLine[]
  usages   PartUsage[]

  @@index([supplierId])
}

model PurchaseOrder {
  id         String    @id @default(uuid()) @db.Uuid
  reference  String    @unique
  supplierId String    @db.Uuid
  status     String    @default("DRAFT")
  totalCents Int       @default(0)
  notes      String?
  orderedAt  DateTime?
  receivedAt DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  partId          String @db.Uuid
  qty             Int
  unitCostCents   Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id])

  @@index([purchaseOrderId])
  @@index([partId])
}

model PartUsage {
  id               String   @id @default(uuid()) @db.Uuid
  bookingReference String
  partId           String   @db.Uuid
  qty              Int
  unitCostCents    Int
  recordedBy       String?
  createdAt        DateTime @default(now())

  part Part @relation(fields: [partId], references: [id])

  @@index([partId])
  @@index([createdAt])
}

// QuickBooks finance integration (2026-11-11), BUILT DARK: the deployed
// API holds no Intuit credentials and cannot call QuickBooks itself.
// Pepper's QuickBooks connector syncs real company data through the
// owner-only POST /finance/sync into these mirror tables; every finance
// surface reads them and stamps the sync time. Until a first sync lands,
// FinanceConnection has no row and the honest status is not_connected.
model FinanceConnection {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @unique @default("quickbooks")
  status      String    @default("not_connected")
  companyName String?
  realmHint   String?
  lastSyncAt  DateTime?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FinanceSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String
  periodLabel String
  payload     Json
  source      String   @default("quickbooks-connector")
  syncedAt    DateTime @default(now())

  @@unique([kind, periodLabel])
  @@index([kind])
}

model FinanceInvoiceMirror {
  id           String    @id @default(uuid()) @db.Uuid
  qbId         String    @unique
  number       String?
  customerName String?
  totalCents   Int       @default(0)
  balanceCents Int       @default(0)
  status       String?
  dueDate      DateTime?
  qbUrl        String?
  syncedAt     DateTime  @default(now())

  @@index([balanceCents])
}

// Speedy chat capture (2026-11-12): every customer conversation with
// Speedy lands here for staff analysis (Chat Insights) — Ramone's
// direction: every customer chat is valuable information for developing
// new features and methods of operations. Capture is passive and
// best-effort: a capture failure never breaks or blocks the chat.
// Transcripts are staff-only data — no public endpoint ever returns
// them. Photo diagnoses record that a diagnosis happened plus the
// customer's note text; the image itself is never stored.
model SpeedyChatSession {
  id                        String   @id @default(uuid()) @db.Uuid
  companyId                 String   @db.Uuid
  userId                    String?  @db.Uuid
  source                    String   @default("unknown")
  startedAt                 DateTime @default(now())
  lastMessageAt             DateTime @default(now())
  messageCount              Int      @default(0)
  hadDiagnosis              Boolean  @default(false)
  convertedBookingReference String?
  hasUnanswered             Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  messages SpeedyChatMessage[]

  @@index([companyId, startedAt])
  @@index([companyId, source, startedAt])
}

model SpeedyChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  role      String
  content   String
  // flagged = this row is evidence for the unanswered mining: an
  // assistant reply that hit the knowledge boundary, or a customer
  // message whose exchange errored out (the client-side snag path).
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now())

  session SpeedyChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Multi-account Google manager registry (2026-11-13): Ramone runs the
// Google presence — Business Profile, Local Services Ads, Google Ads,
// Search Console — from more than one Gmail account, and directed a
// registry inside Marketing OS where more Gmail accounts can be added,
// each with its business profiles and ads accounts, all linked to the
// Service OS. This table is that registry. It is a RECORD of the
// structure, not a live Google connection: invites are sent and
// accepted inside Google's own screens, and a human updates a status
// here after the Google side confirms it. Statuses stay truthful —
// nothing auto-flips an INVITED account to ACTIVE.
model GoogleAccountLink {
  id     String @id @default(uuid()) @db.Uuid
  email  String @unique
  label  String
  // PRIMARY_OWNER / OWNER / MANAGER / ADMIN
  role   String @default("MANAGER")
  // INVITED / ACTIVE / REVOKED
  status String @default("INVITED")
  // Structured asset links, kept as JSON so the registry can grow new
  // asset kinds without a migration each time:
  // { gbpProfiles: [{ name, verificationStatus }],
  //   adsAccounts: [{ customerId, name, status }],
  //   lsaAccounts: [{ id, status }],
  //   searchConsole: boolean }
  assets Json   @default("{}")

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Top Speed Media OS — Phase 1 (2026-11-14, blueprint
// Top_Speed_Media_OS_Expanded_Blueprint, built on the existing Service
// OS stack per the approved digest). The content library behind
// /media: five divisions (Videos, Publishing, News, Social, Live), one
// editorial workflow (DRAFT → IN_REVIEW → APPROVED → SCHEDULED →
// PUBLISHED → ARCHIVED, enforced in routes/mediaOs.js), and an asset
// registry carrying rights status. Hydrated from these tables via
// db/mediaOsRepo into the in-memory store, like the Marketing OS
// add-ons; a missing table mid-deploy degrades to an empty library.
model MediaContent {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique
  type           MediaContentType
  division       MediaDivision
  title          String
  description    String?
  assetUrl       String?
  thumbnailUrl   String?
  durationSec    Int?
  transcript     String?            @db.Text
  destinationUrl String?
  status         MediaContentStatus @default(DRAFT)
  publishAt      DateTime?
  publishedAt    DateTime?
  tags           String[]           @default([])
  createdBy      String
  updatedBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  assets MediaAsset[]

  adCampaigns AdCampaign[]

  @@index([status, division])
  @@index([division, publishedAt])
}

model MediaAsset {
  id          String                 @id @default(uuid()) @db.Uuid
  contentId   String?                @db.Uuid
  kind        String
  name        String
  url         String?
  rightsStatus MediaAssetRightsStatus @default(PENDING_REVIEW)
  rightsNote  String?
  createdAt   DateTime               @default(now())

  content MediaContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([contentId])
}

// ─── Ad Studio (in-house advertising system, 2026-11-14) ────────────
// Ramone's own ad system on the Service OS: campaigns are built from
// Media OS creatives, send traffic to his own published landing pages,
// and run as placements on his own platform surfaces (the flagship
// footer Banner rotation). Nothing outside is bought and no money
// moves — a campaign goes live only when the owner (MASTER) approves
// it, and results are counted from real bookings/connections that
// carry the campaign's sourceTag.
enum AdBusinessLine {
  TOP_SPEED
  CLEANOUT_VENTS
  COCOCANE
}

enum AdCampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  ENDED
}

enum AdPlacement {
  BANNER
  NONE
}

model AdCampaign {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  businessLine   AdBusinessLine
  objective      String
  status         AdCampaignStatus @default(DRAFT)
  creativeId     String?          @db.Uuid
  destinationUrl String
  sourceTag      String           @unique
  placement      AdPlacement      @default(NONE)
  bannerId       String?          @db.Uuid
  notes          String?
  createdById    String?          @db.Uuid
  approvedById   String?          @db.Uuid
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  creative MediaContent? @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([businessLine, status])
}

// Management department reports (2026-11-14): every request any platform
// feature produces — booking, referral, subscription/offer sign-up,
// account, job event, payment, training, publish, campaign action —
// lands here as ONE report routed to the head department that owns it,
// with the exact request detail, for management to read + acknowledge.
// Emitted failure-proof from services/managementReports.js; the
// in-memory store is the working set, this table is the durable record.
model DepartmentReport {
  id         String   @id @default(uuid()) @db.Uuid
  department String
  type       String
  title      String
  detail     Json     @default("{}")
  source     String?
  reference  String?
  eventKey   String?  @unique
  status     String   @default("NEW")
  ackById    String?  @db.Uuid
  ackAt      DateTime?
  createdAt  DateTime @default(now())

  @@index([department, status])
  @@index([createdAt])
}
